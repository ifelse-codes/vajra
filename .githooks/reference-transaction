#!/usr/bin/env bash
# Tracked reference-transaction: the agent moves main/master only to what the remote already has
# (S202 bug bash, F123's named routes).
#
# pre-commit stops a commit on main and pre-merge-commit stops a merge commit, but a fast-forward
# merge, `reset --hard`, `branch -f` and `update-ref` make no commit, so neither hook fired and main
# could still be moved onto work nobody reviewed (DECISION-007 S194 addendum). Every one of them
# updates the branch, and git runs this hook on every branch update. So: an agent shell may move
# main/master only to a commit that origin's copy of that branch already contains — `git pull
# --ff-only` after a merged pull request still works, and so does going back to an older commit.
# A person gets a note and the move goes on (founder's call, the S171 split — the same as pre-push).
# HONEST LIMIT: no `origin/<branch>` (a local-only repo, or a remote with another name) means there
# is nothing to follow, so nothing is checked; "agent" means one of the four markers below is set;
# `core.hooksPath` must be `.githooks`. Bar-raising, not tamper-proof.

set -uo pipefail

# Only the "prepared" call can stop a move; "committed" and "aborted" are reports.
[ "${1:-}" = prepared ] || exit 0

agent_shell=0
if [ -n "${CLAUDECODE:-}${CLAUDE_CODE_ENTRYPOINT:-}${CURSOR_TRACE_ID:-}${VAJRA_AGENT:-}" ]; then
  agent_shell=1
fi

updates="$(cat)"
blocked=0
while read -r _old new ref; do
  case "$ref" in refs/heads/main|refs/heads/master) ;; *) continue ;; esac
  branch="${ref#refs/heads/}"
  case "$new" in *[!0]*) ;; *) continue ;; esac   # a delete moves main onto nothing
  # git may leave the old value unset (all zeros), so compare with where the branch is now.
  [ "$new" = "$(git rev-parse -q --verify "$ref" 2>/dev/null || true)" ] && continue
  # origin's copy as it stands after THIS transaction: `git fetch origin main:main` moves both.
  remote="$(printf '%s\n' "$updates" | awk -v r="refs/remotes/origin/$branch" '$3 == r { v = $2 } END { print v }')"
  [ -n "$remote" ] || remote="$(git rev-parse -q --verify "refs/remotes/origin/$branch" 2>/dev/null || true)"
  [ -n "$remote" ] || continue
  if [ "$new" = "$remote" ] || git merge-base --is-ancestor "$new" "$remote" 2>/dev/null; then
    continue
  fi
  short="${new:0:7}"
  if [ "$agent_shell" = 1 ]; then
    echo "Vajra stopped this: it would move '$branch' to $short, which origin/$branch does not have." >&2
    echo "  Work reaches $branch through a pull request: push the session branch and open one." >&2
    echo "  After the pull request is merged, \`git pull --ff-only\` on $branch brings it in." >&2
    blocked=1
  else
    echo "Note: moving '$branch' to $short, which origin/$branch does not have. The usual path is a" >&2
    echo "      pull request, so the work has a review trail. Moving anyway." >&2
  fi
done <<< "$updates"

exit "$blocked"
