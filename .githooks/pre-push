#!/usr/bin/env bash
# Tracked pre-push: keeps the AGENT off main/master.
#
# S171 (founder's first-run test): this used to refuse every push to main, the human's included.
# After a session was merged locally, that left the work stranded — pushing main was refused and
# a pull request was no longer possible, because main already had the commits. A person pushing
# their own main now gets a note, not a wall; an agent shell is still stopped. Same layering as
# .githooks/pre-commit: this belt is auditable, the L3 publish guard has the teeth.

set -euo pipefail

agent_shell=0
if [ -n "${CLAUDECODE:-}${CLAUDE_CODE_ENTRYPOINT:-}${CURSOR_TRACE_ID:-}${VAJRA_AGENT:-}" ]; then
  agent_shell=1
fi

blocked=0
while read -r localref localsha remoteref remotesha; do
  [ -z "${remoteref:-}" ] && continue
  case "$remoteref" in
    refs/heads/main|refs/heads/master)
      if [ "$agent_shell" = 1 ]; then
        echo "Vajra stopped this push: the agent may not push '$remoteref' straight up."
        echo "  Push the session branch and open a pull request instead."
        blocked=1
      else
        echo "Note: pushing '$remoteref' directly. The usual path is to push the session branch"
        echo "      and open a pull request, so the work has a review trail. Pushing anyway."
      fi ;;
  esac
done

exit "$blocked"
