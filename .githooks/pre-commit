#!/usr/bin/env bash
# Tracked pre-commit hook. Activated by: git config core.hooksPath .githooks

set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo DETACHED)"
case "$branch" in
  main|master)
    echo "Vajra stopped this commit: you are on '$branch'."
    echo "  Work happens on a session branch. Make one first:"
    echo "      git checkout -b session-NN-<what-this-session-is>"
    exit 1 ;;
esac

# --- Who is typing this commit? (S171 — from the founder's first-run test) -------------------
# This belt exists to stop the AGENT committing on its own. It was stopping the HUMAN too: a
# founder's own `git add -A && git commit -m "Add Vajra"`, the very first commit after
# `vajra init`, was refused — and the fix it suggested could not work (38 files, 3-file cap).
# So: a commit typed by a person in their own terminal goes through. An agent shell still needs
# the approval marker. Claude Code sets CLAUDECODE / CLAUDE_CODE_ENTRYPOINT; Cursor sets
# CURSOR_TRACE_ID; any other agent can declare itself with VAJRA_AGENT=1.
#
# Honesty about layers, in two parts (the second added by S171's cold review, rec 9):
#  1. An agent that writes the command line can drop those variables for one command, so this
#     git-level belt was always auditable, never un-forgeable.
#  2. The teeth are the L3 PreToolUse guard (scripts/hook-commit-guard.sh), which reads its OWN
#     launch environment and fires even on `git commit --no-verify` — but that guard exists ONLY
#     under Claude Code. For any other agent that does not set VAJRA_AGENT=1, this split removes
#     the last enforcement layer rather than relocating it. Set VAJRA_AGENT=1 in that agent's
#     environment if you want the belt to hold there.
agent_shell=0
if [ -n "${CLAUDECODE:-}${CLAUDE_CODE_ENTRYPOINT:-}${CURSOR_TRACE_ID:-}${VAJRA_AGENT:-}" ]; then
  agent_shell=1
fi

# --- Approval-evidence gate (S93 — no-autonomous-commit: voluntary -> ENFORCED) --------------
# On a session branch, a commit requires an un-forgeable human approval marker: the env var
# VAJRA_ALLOW_COMMIT must equal the branch's session number. Same house pattern as
# VAJRA_CLOSEOUT_WAIVER (S56) and VAJRA_ALLOW_PUBLISH (S37): an env var the founder supplies,
# NOT a file/flag the agent can Write into the tree (that would be in the diff, and self-granted
# — the S69 "jurisdiction-self-granted" fakest-green class). Fail-closed: no marker => BLOCK.
# Session-scoped so a stale VAJRA_ALLOW_COMMIT from another session does not authorize this one.
#
# Layer honesty: this L2 belt is git-native and catches every commit path. But an agent that
# controls the command line can inline `VAJRA_ALLOW_COMMIT=NN git commit`, so L2 alone is
# auditable, not un-forgeable. The un-forgeable teeth are the L3 PreToolUse hook
# (scripts/hook-commit-guard.sh): its launch env is beyond an inline prefix's reach, and it
# fires even on `git commit --no-verify` (which skips THIS hook but not PreToolUse). To commit
# autonomously the agent must beat BOTH layers. See sessions/session-93-summary.md.
if [ "$agent_shell" = 1 ] && [[ "$branch" =~ ^session-([0-9]+)- ]]; then
  sess="${BASH_REMATCH[1]}"
  if [ "${VAJRA_ALLOW_COMMIT:-}" != "$sess" ]; then
    echo "Vajra stopped this commit: the agent has no approval to commit for session $sess."
    echo
    echo "  If YOU are typing this, run it in your own terminal instead — Vajra does not ask a"
    echo "  person for approval. (It does still stop anyone committing on main, on .ai/ drift,"
    echo "  or when the drift-guard says no.)"
    echo
    echo "  To let the agent commit, start it with the approval already given:"
    echo "      VAJRA_ALLOW_COMMIT=$sess vajra claude"
    echo "  or approve this one commit:"
    echo "      VAJRA_ALLOW_COMMIT=$sess git commit ..."
    exit 1
  fi
fi

# The 3-files-per-commit rule keeps an AGENT's changes reviewable. A person committing their
# own work is not the problem it was written for — and the first commit of a new Vajra project
# is ~38 scaffold files (S171).
staged="$(git diff --cached --name-only --diff-filter=ACMR | sed '/^$/d' | wc -l | tr -d ' ')"
if [ "$agent_shell" = 1 ] && [ "${staged:-0}" -gt 3 ]; then
  echo "Vajra stopped this commit: $staged files at once; an agent commits at most 3."
  echo "  Commit them in smaller, related groups."
  # S174 F61: rudra S05's agent re-ran `git add` on 3 files and hit this three times — the 8 from
  # the failed commit were still staged. Say so.
  echo "  All $staged are STILL STAGED — unstage first: git reset -q, then git add at most 3 and commit."
  exit 1
fi

if [ -f .ai/SESSION ] && [ -f .ai/SESSION-BOOT.md ]; then
  n="$(tr -d ' \t\n\r' < .ai/SESSION)"
  boot="$(grep -m1 -E '\*\*Number:\*\*' .ai/SESSION-BOOT.md | grep -oE '[0-9]+' | head -1)"
  if [ -n "$n" ] && [ -n "$boot" ] && [ "$((10#$n))" -ne "$((10#$boot))" ]; then
    echo "[pre-commit BLOCK] .ai/ drift: .ai/SESSION=$n but SESSION-BOOT Number=$boot."
    # S174 F63: rudra S05 and Vajra S174 both hit this on their first commit.
    echo "  They move together: set \`- **Number:** $n\` under \`## Current Session\` in .ai/SESSION-BOOT.md and commit both."
    exit 1
  fi
fi

if [ -x scripts/hook-drift-guard.sh ]; then
  scripts/hook-drift-guard.sh --quiet || {
    echo "[pre-commit BLOCK] drift-guard reported drift."
    exit 1
  }
fi

exit 0
