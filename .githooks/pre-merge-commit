#!/usr/bin/env bash
# Tracked pre-merge-commit: no merge commit on main/master (S194, F123).
#
# A merge commit runs git's pre-merge-commit hook, never pre-commit — so pre-commit's "not on
# main" check never saw `git checkout main && git merge --no-ff <branch>`. rudra S20's agent did
# exactly that 24 seconds after its close check went RED. Same rule as pre-commit's first check
# and the 2026-09-21 founder decision: nobody commits on main/master, human or agent. Only the
# branch is checked: merging main INTO a session branch is not this hook's business.
#
# A fast-forward merge, `reset --hard`, `branch -f`, `update-ref` make no commit, so this hook
# never fires for them (DECISION-007 S194 addendum); since the S202 bug bash
# .githooks/reference-transaction stops the agent moving main onto work origin does not have.

set -euo pipefail

branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo DETACHED)"
case "$branch" in
  main|master)
    echo "Vajra stopped this merge: you are on '$branch'."
    echo "  Work reaches $branch through a pull request: push the session branch and open one."
    exit 1 ;;
esac

exit 0
