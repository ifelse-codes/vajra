+PYEOF
+  if cross_check_dir "$TMP" >/dev/null 2>&1; then
+    echo "FAIL: the cross-check accepted a dispatch of a different agent type"; rc=1
+  else
+    echo "OK: a different subagent_type is REJECTED"
+  fi
