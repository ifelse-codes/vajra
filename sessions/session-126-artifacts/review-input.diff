+# --- 3b. K of 8 is untouched by the roster, with all five handoffs present -----------------------
+k_of_8_unchanged() {
+  local TMP; TMP="$(mktemp -d)"; local rc=0
+  ( cd "$TMP" && git init -q . && "$VAJRA" init >/dev/null </dev/null ) || { rm -rf "$TMP"; return 1; }
+  echo "126" > "$TMP/.ai/SESSION"
