+{"parentUuid":"b51d5e2a-674b-4401-80bf-a13d52499590","isSidechain":true,"agentId":"a554e0bd77d8cce41","message":{"model":"claude-sonnet-5","id":"msg_011CdvxA86vK91Wnebo6yesi","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01RRE1uAMTpPRKgEz6r3qQUx","name":"Read","input":{"file_path":"/Users/suman/playground/vajra/src/cli/next.rs"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2177,"cache_read_input_tokens":13001,"output_tokens":179,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":2177},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":179,"cache_read_input_tokens":13001,"cache_creation_input_tokens":2177,"cache_creation":{"ephemeral_5m_input_tokens":2177,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011CdvxA56baoVaiqDAPUys4","attributionAgent":"plan-advisor","type":"assistant","uuid":"c1b1d951-b99a-44e5-8e6b-1cf6ecf9409f","timestamp":"2026-08-11T12:21:20.524Z","effort":"high","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/suman/playground/vajra","sessionId":"87bcd7e1-22ce-4cfb-b4a3-536c21c126e7","version":"2.1.222","gitBranch":"session-117-plan-advisor-dispatch"}
+{"parentUuid":"b51d5e2a-674b-4401-80bf-a13d52499590","isSidechain":true,"promptId":"debef159-52a1-43ee-a9e4-e943af52f8db","agentId":"a554e0bd77d8cce41","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VQwHzjxThWhWseKXpEqoE3","type":"tool_result","content":"1\t//! S109 — fleet slice 1: one named agent role (the Researcher) dispatched as a NATIVE Claude Code\n2\t//! **subagent** and governed by Vajra. Locked by `docs/decisions/DECISION-007-agent-fleet.md`.\n3\t//!\n4\t//! Vajra is an external binary — it does not (cannot) *call* a Claude Code subagent; subagents only\n5\t//! exist inside a running agent session. So Vajra's job for a named role is two things, both in this\n6\t//! module's contract:\n7\t//!   1. **Scaffold** the role as a native subagent definition (`.claude/agents/<name>.md`), rendered\n8\t//!      from ONE canonical source (the S104/S99 no-drift rule) — the same way `vajra init` already\n9\t//!      scaffolds `.claude/settings.json` + hooks (S44). The role prompt is vendor-neutral here;\n10\t//!      only the *rendering* is Claude-specific.\n11\t//!   2. **Govern the handoff.** The subagent returns a findings brief; Vajra wraps it into a\n12\t//!      delta-tracked handoff in the `.ai/` spine (the memory — no new store) and FAIL-CLOSES on an\n13\t//!      unknown role, missing/empty findings, or a handoff that would not validate.\n14\t//!\n15\t//! This module is the PURE core (role resolution, subagent rendering, handoff format + validate +\n16\t//! delta, one hash). The impure edges (reading findings, writing files, git) live in `cli::next` /\n17\t//! `cli::init`. Everything here is unit-testable without spawning anything.\n18\t//!\n19\t//! S112 adds the READ side — `read_handoff`/`read_handoffs` — so a station can consume what the\n20\t//! fleet produced. That is one narrow, fs-READ-only edge (no writes, no processes, tempdir-testable);\n21\t//! its parsing core, `parse_handoff`, stays pure like everything else here.\n22\t//!\n23\t//! S114 adds the SECOND role — the **Fidelity Reviewer** (chosen from evidence at S113, built here;\n24\t//! `DECISION-007` S114 addendum). No new machinery: it is one more `ROLES` entry, and every path\n25\t//! above already iterates the roles. What it DID force is honesty about the single source — the tool\n26\t//! grant and the delta text were both hardcoded to the Researcher while only one role existed, and\n27\t//! are now per-role.\n28\t//!\n29\t//! S116 adds the THIRD role — the **Plan Advisor** (founder pick B at the S115 closeout, named\n30\t//! Planner specifically; `DECISION-007` S116 addendum). Same zero-new-machinery shape as S114. Its\n31\t//! key is `plan-advisor`, not `planner` — the exact collision the S114 addendum resolved for the\n32\t//! Reviewer, now hit a second time against the Planner **station** (`src/planner/mod.rs`, S64),\n33\t//! which already counts a \"Planner\" in `K of 8`. Its contract is the `covers: N` marker that\n34\t//! station's gate already parses and grades (`cited_criteria` in `src/planner/mod.rs`) — the role\n35\t//! proposes citations in that exact shape; it does not gain any new parsing or grading path.\n36\t\n37\tuse std::io::Write;\n38\tuse std::process::{Command, Stdio};\n39\t\n40\t/// A named fleet role: its key, a one-line description (for the subagent picker), the system prompt\n41\t/// that scopes the agent, and — via `handoff_rel` — where its governed handoff lands. The ONE place\n42\t/// role text lives; both the subagent definition and the handoff are rendered from it (no drift).\n43\tpub struct Role {\n44\t    /// The `--role <name>` key and the subagent `name:`. Lower-case, stable — the join key.\n45\t    pub name: &'static str,\n46\t    /// One line describing WHEN to use this role — the subagent frontmatter `description:`.\n47\t    pub description: &'static str,\n48\t    /// The role-scoping system prompt — the subagent definition body.\n49\t    pub system_prompt: &'static str,\n50\t    /// This role's tool grant, rendered verbatim into the subagent frontmatter `tools:`. Per-role\n51\t    /// (S114) — it was hardcoded to the Researcher's list while only one role existed, which would\n52\t    /// have silently handed every future role the Researcher's web access. **Every registered role\n53\t    /// is read-only**; a role that could write is a materially bigger governance decision\n54\t    /// (DECISION-007) and none is taken here.\n55\t    pub tools: &'static str,\n56\t}\n57\t\n58\timpl Role {\n59\t    /// Where this role's governed handoff for `session` lands, repo-relative. `.ai/` IS the memory\n60\t    /// (DECISION-007 / `feedback-map-concepts-to-vajra`) — no new store, no 8th artifact type.\n61\t    pub fn handoff_rel(&self, session: u32) -> String {\n62\t        format!(\".ai/handoffs/session-{session:02}-{}.md\", self.name)\n63\t    }\n64\t\n65\t    /// Where this role's native subagent definition is scaffolded, repo-relative — the standard\n66\t    /// Claude Code `.claude/agents/<name>.md` location.\n67\t    pub fn subagent_rel(&self) -> String {\n68\t        format!(\".claude/agents/{}.md\", self.name)\n69\t    }\n70\t}\n71\t\n72\tconst RESEARCHER_SYSTEM_PROMPT: &str = \"You are the Researcher on a governed software team. \\\n73\tYour ONE job is to investigate the question you are given and return a concise, decision-ready \\\n74\tfindings brief.\\n\\\n75\tRules:\\n\\\n76\t- Do NOT write, edit, or run code. You investigate and report only.\\n\\\n77\t- Lead with the answer, then the few facts that support it.\\n\\\n78\t- Prefer specifics (names, numbers, versions, trade-offs) over generalities.\\n\\\n79\t- If the question is ambiguous or you are unsure, say so plainly — never invent facts or sources.\\n\\\n80\t- Keep it short: a busy engineer should be able to act on it in under a minute.\";\n81\t\n82\t/// The Reviewer's contract (S114). This is the brief this repo has re-typed from memory every\n83\t/// session for 47 cold reviews — made canonical here, which is the whole point of `ROLES`.\n84\t///\n85\t/// Two things it states that no other role does, both locked by the `DECISION-007` S114 addendum:\n86\t/// the verdict it returns is a **pre-stage input**, and the canonical, gated record of the verdict\n87\t/// stays `sessions/session-NN-review.md` — this agent never writes that file (it has no write tool\n88\t/// and is told not to ask for one).\n89\tconst FIDELITY_REVIEWER_SYSTEM_PROMPT: &str =\n90\t    \"You are the Fidelity Reviewer on a governed software \\\n91\tteam. Your ONE job is an INDEPENDENT, ADVERSARIAL cold review of a delivery you did not build.\\n\\\n92\tYou are fed only two things: the session prompt (what was asked) and the diff (what was done). \\\n93\tJudge from those. Do not accept the builder's own summary as evidence.\\n\\\n94\tRules:\\n\\\n95\t- Do NOT write, edit, or run code. You read and judge only.\\n\\\n96\t- Grade EVERY numbered requirement in the prompt: SHIPPED / PARTIAL / NOT-BUILT, each with the \\\n97\tconcrete evidence in the diff that earns the grade. A requirement with no evidence is NOT-BUILT.\\n\\\n98\t- Following the rules is not delivering what was asked: a green verify script proves discipline, \\\n99\tnever fidelity. Never grade from test counts alone.\\n\\\n100\t- Name THE FAKEST GREEN — the thing that looks done but is hollow (a check that would pass if the \\\n101\tfeature were deleted, a marker the author simply typed, an assertion that cannot fail).\\n\\\n102\t- Never self-certify and never soften: if the delivery is short, say so.\\n\\\n103\tShape your brief so it can be landed without rewriting — the closeout gate reads the landed record \\\n104\tand FAILS unless it carries all three of these:\\n\\\n105\t- a per-requirement MARKDOWN TABLE — the gate counts verdict words only on `|`-delimited rows and \\\n106\trequires at least three of them, so one row per requirement carrying SHIPPED / PARTIAL / NOT-BUILT \\\n107\t(a bulleted list with the same words does NOT pass),\\n\\\n108\t- a canonical `**Verdict:** ACCEPT` or `**Verdict:** REJECT` line (the word buried in a heading \\\n109\tdoes not count),\\n\\\n110\t- a count of the form `X of N SHIPPED`.\\n\\\n111\tThe full contract you are performing is `reviewer/SKILL.md` in this repo — READ IT before you \\\n112\tjudge; it is canonical and this brief is its dispatch-time summary, never a competing version.\\n\\\n113\tYour verdict is a PRE-STAGE INPUT. The canonical, gated record of the fidelity verdict is \\\n114\t`sessions/session-NN-review.md` (read by `verify-closeout.sh`, attested by a `**Review-Inputs-SHA:**` \\\n115\tthe orchestrator computes, chained in the ledger) — you do not write it, and you are not its \\\n116\treplacement.\";\n117\t\n118\t/// The Plan Advisor's contract (S116). Fed a session's goal + numbered acceptance criteria, it\n119\t/// proposes ordered plan steps citing which criterion/criteria each covers, in the exact `covers: N`\n120\t/// shape `src/planner/mod.rs::cited_criteria` already parses and `plan_coverage` already grades. It\n121\t/// proposes; it never authors the recorded plan (no Write/Edit — the same fail-closed shape as the\n122\t/// other two roles, stated explicitly here because \"planning\" reads closer to \"editing the plan\"\n123\t/// than \"researching\" or \"reviewing\" did).\n124\tconst PLAN_ADVISOR_SYSTEM_PROMPT: &str = \"You are the Plan Advisor on a governed software team. \\\n125\tYour ONE job is to propose an ordered, coverage-checked plan for a session BEFORE any code is \\\n126\twritten.\\n\\\n127\tYou are fed two things: the session's goal and its numbered acceptance criteria. Propose ordered \\\n128\tplan steps that would satisfy them.\\n\\\n129\tRules:\\n\\\n130\t- Do NOT write, edit, or run code, and do NOT write the plan into the prompt file yourself — you \\\n131\tpropose, the author records. You have no Write or Edit tool, by design.\\n\\\n132\t- Every step you propose must explicitly cite which acceptance-criterion number(s) it covers, in \\\n133\tthe exact form `covers: N` or `covers: N, M` — a comma/whitespace-separated digit list straight \\\n134\tafter the literal word `covers:`. This is the exact marker the Planner station's gate parses and \\\n135\tgrades; a step without it counts as uncovered, not merely undocumented.\\n\\\n136\t- Cover EVERY numbered criterion with at least one step. A criterion your plan does not cite is a \\\n137\tgap — say so plainly rather than silently leaving it out.\\n\\\n138\t- Do not invent criteria you were not given, and do not renumber the ones you were given.\\n\\\n139\t- Order steps so each is buildable given only the steps before it.\\n\\\n140\t- If the goal or the criteria are ambiguous, say so plainly rather than guessing a plan around the \\\n141\tambiguity.\\n\\\n142\tYour output is a PROPOSAL, never the plan of record: the session's own `## Plan` section, inside \\\n143\tits own prompt file, is the only place a real plan lives — you do not create a second artifact, and \\\n144\tonly the session's author decides what actually lands there.\";\n145\t\n146\t/// The registered roles. Slice 1 (DECISION-007) shipped exactly ONE — the Researcher. S114 added the\n147\t/// SECOND (the Fidelity Reviewer, chosen from evidence at S113). S116 adds the THIRD: the Plan\n148\t/// Advisor (founder pick at the S115 closeout). A fourth role remains a separate decision, not a\n149\t/// reflex (the named key risk of S109 is scope creep).\n150\t///\n151\t/// **The Reviewer's key is `fidelity-reviewer`, not `reviewer`** — the deliberate resolution of the\n152\t/// collision the S113 cold review named (`DECISION-007` S114 addendum). `K of 8` already counts a\n153\t/// **Reviewer station**; a role keyed `reviewer` would make \"Reviewer\" mean two different things in\n154\t/// two lines of the same report.\n155\t///\n156\t/// **The Planner's key is `plan-advisor`, not `planner`** — the exact same collision, hit a second\n157\t/// time: `K of 8` already counts a **Planner station** (`src/planner/mod.rs`, S64). Distinct key,\n158\t/// distinct word, no ambiguity (`DECISION-007` S116 addendum).\n159\tpub const ROLES: &[Role] = &[\n160\t    Role {\n161\t        name: \"researcher\",\n162\t        description: \"Investigate a question and return a concise, decision-ready findings brief. \\\n163\t                      Use before a design or build decision that needs facts, trade-offs, or prior \\\n164\t                      art. Read-only — never writes code.\",\n165\t        system_prompt: RESEARCHER_SYSTEM_PROMPT,\n166\t        // Investigation needs the web; judging a diff does not.\n167\t        tools: \"Read, Grep, Glob, WebSearch, WebFetch\",\n168\t    },\n169\t    Role {\n170\t        name: \"fidelity-reviewer\",\n171\t        description: \"Independently cold-review a finished delivery against the session prompt: \\\n172\t                      grade every numbered requirement SHIPPED/PARTIAL/NOT-BUILT and name the \\\n173\t                      fakest green. Use at close, never on your own work. Read-only.\",\n174\t        system_prompt: FIDELITY_REVIEWER_SYSTEM_PROMPT,\n175\t        // Strictly local reads. No web (a fidelity call is decided by the prompt and the diff in\n176\t        // front of it, not by the internet) and no Bash (running things is the QA station's job,\n177\t        // live — DECISION-007 rejected swapping those teeth for an agent's prose).\n178\t        tools: \"Read, Grep, Glob\",\n179\t    },\n180\t    Role {\n181\t        name: \"plan-advisor\",\n182\t        description: \"Propose an ordered, coverage-checked plan mapping a session's acceptance \\\n183\t                      criteria to plan steps (`covers: N`), before code is written. Use during \\\n184\t                      planning, never to author the recorded `## Plan` itself. Read-only.\",\n185\t        system_prompt: PLAN_ADVISOR_SYSTEM_PROMPT,\n186\t        // Strictly local reads, same shape as the Reviewer: planning a session is decided by that\n187\t        // session's own prompt, not the internet, and it does not run anything.\n188\t        tools: \"Read, Grep, Glob\",\n189\t    },\n190\t];\n191\t\n192\t/// Resolve a role by its key. `None` (→ the caller fails closed) for an unknown role: vajra never\n193\t/// governs a role it cannot scope.\n194\tpub fn resolve_role(name: &str) -> Option<&'static Role> {\n195\t    ROLES.iter().find(|r| r.name == name)\n196\t}\n197\t\n198\t/// The known role names, comma-joined — for a fail-closed \"unknown role\" error message.\n199\tpub fn known_roles() -> String {\n200\t    ROLES.iter().map(|r| r.name).collect::<Vec<_>>().join(\", \")\n201\t}\n202\t\n203\t/// Render a role as a native Claude Code subagent definition (`.claude/agents/<name>.md`): YAML\n204\t/// frontmatter (`name`, `description`, read-only `tools`) + the system prompt + a short note that\n205\t/// its findings become a Vajra-governed handoff (so the subagent returns a brief, and does NOT try\n206\t/// to author the handoff frontmatter — Vajra owns that). Rendered from the SAME `Role` the handoff\n207\t/// uses — one canonical source, no drift.\n208\tpub fn render_subagent_definition(role: &Role) -> String {\n209\t    format!(\n210\t        \"---\\n\\\n211\t         name: {name}\\n\\\n212\t         description: {desc}\\n\\\n213\t         tools: {tools}\\n\\\n214\t         ---\\n\\\n215\t         \\n\\\n216\t         {sys}\\n\\\n217\t         \\n\\\n218\t         ## Governed handoff (Vajra owns this)\\n\\\n219\t         Return your findings brief as your final message. The orchestrator records it as a\\n\\\n220\t         Vajra-governed, delta-tracked handoff at `.ai/handoffs/session-<NN>-{name}.md` via\\n\\\n221\t         `vajra next --role {name} --from <file>`. Do NOT write the handoff frontmatter yourself —\\n\\\n222\t         Vajra computes the source hash, the timestamp, and the delta against the prior stage.\\n\",\n223\t        name = role.name,\n224\t        desc = role.description,\n225\t        tools = role.tools,\n226\t        sys = role.system_prompt,\n227\t    )\n228\t}\n229\t\n230\t/// The `## Handoff Delta` body: what this handoff adds relative to the PRIOR stage. A first handoff\n231\t/// has no prior (the prior stage is the session prompt / Analyst's WHAT), so the delta records\n232\t/// \"new\"; a re-run against an existing handoff records the size change. This is what makes the\n233\t/// handoff a *tracked* artifact with a recorded delta, not an opaque dump.\n234\t///\n235\t/// S114: takes the `role` instead of writing the word \"researcher\" into every delta. With one role\n236\t/// registered the hardcoding was invisible; with two it would have stamped a Reviewer handoff with\n237\t/// the Researcher's name — the single-source drift this module exists to prevent.\n238\tpub fn compute_delta(role: &Role, prior_body: Option<&str>, new_body: &str) -> String {\n239\t    match prior_body {\n240\t        None => format!(\n241\t            \"- `+` new: first {role} handoff for this session ({} bytes of findings)\\n\\\n242\t             - prior stage: the session prompt (Analyst WHAT) — no prior handoff to diff against\",\n243\t            new_body.len(),\n244\t            role = role.name\n245\t        ),\n246\t        Some(p) => format!(\n247\t            \"- `~` re-run: {role} handoff replaced ({} bytes now vs {} bytes prior)\\n\\\n248\t             - prior stage: this session's earlier {role} handoff\",\n249\t            new_body.len(),\n250\t            p.len(),\n251\t            role = role.name\n252\t        ),\n253\t    }\n254\t}\n255\t\n256\t/// Format the governed handoff artifact (the DECISION-007 contract). Deterministic given its\n257\t/// inputs — the timestamp is passed in so this stays pure and testable. `cost` is the subagent's\n258\t/// metered dollars when known, else `None`. **S111 checked this, not guessed it, with a re-runnable\n259\t/// script** (`scripts/check-subagent-cost-fields.sh`, not a one-off count baked in here): every real\n260\t/// subagent JSONL transcript on the checking machine was scanned — zero carry a `total_cost_usd` /\n261\t/// `cost_usd` key. A Task-tool subagent never produces the `-p` headless result stream that field is\n262\t/// emitted on (same root cause as S77/S78), so the figure structurally does not exist for Vajra to\n263\t/// read — `null` is the honest, checked answer, not a gap to close.\n264\t#[allow(clippy::too_many_arguments)]\n265\tpub fn format_handoff(\n266\t    role: &Role,\n267\t    session: u32,\n268\t    agent_label: &str,\n269\t    source_sha: &str,\n270\t    captured_utc: &str,\n271\t    cost: Option<f64>,\n272\t    body: &str,\n273\t    delta: &str,\n274\t) -> String {\n275\t    let cost_str = match cost {\n276\t        Some(c) => format!(\"{c:.6}\"),\n277\t        None => \"null\".to_string(),\n278\t    };\n279\t    format!(\n280\t        \"---\\n\\\n281\t         role: {role}\\n\\\n282\t         session: {session}\\n\\\n283\t         agent: {agent}\\n\\\n284\t         source-sha: {sha}\\n\\\n285\t         captured: {captured}\\n\\\n286\t         cost_usd: {cost}\\n\\\n287\t         ---\\n\\\n288\t         \\n\\\n289\t         # {Role} handoff — session {session}\\n\\\n290\t         \\n\\\n291\t         {body}\\n\\\n292\t         \\n\\\n293\t         ## Handoff Delta\\n\\\n294\t         {delta}\\n\",\n295\t        role = role.name,\n296\t        Role = title_case(role.name),\n297\t        agent = agent_label,\n298\t        sha = source_sha,\n299\t        captured = captured_utc,\n300\t        cost = cost_str,\n301\t    )\n302\t}\n303\t\n304\tfn title_case(s: &str) -> String {\n305\t    let mut c = s.chars();\n306\t    match c.next() {\n307\t        None => String::new(),\n308\t        Some(f) => f.to_uppercase().collect::<String>() + c.as_str(),\n309\t    }\n310\t}\n311\t\n312\t/// The six frontmatter keys the handoff contract requires (DECISION-007).\n313\tconst FRONTMATTER_KEYS: [&str; 6] = [\n314\t    \"role:\",\n315\t    \"session:\",\n316\t    \"agent:\",\n317\t    \"source-sha:\",\n318\t    \"captured:\",\n319\t    \"cost_usd:\",\n320\t];\n321\t\n322\t/// A handoff is well-formed iff it carries every frontmatter contract key, a non-empty findings\n323\t/// body, AND the `## Handoff Delta` section (DECISION-007). Used by the fail-closed governance: a\n324\t/// malformed or empty handoff must NEVER read as a successful step. `Err(reason)` names the first\n325\t/// missing piece.\n326\tpub fn validate_handoff(text: &str) -> Result<(), String> {\n327\t    for key in FRONTMATTER_KEYS {\n328\t        if !text.lines().any(|l| l.trim_start().starts_with(key)) {\n329\t            return Err(format!(\"handoff missing frontmatter key `{key}`\"));\n330\t        }\n331\t    }\n332\t    if !text.contains(\"## Handoff Delta\") {\n333\t        return Err(\"handoff missing `## Handoff Delta` section\".into());\n334\t    }\n335\t    match handoff_body(text) {\n336\t        Some(b) if !b.trim().is_empty() => Ok(()),\n337\t        _ => Err(\"handoff has an empty findings body\".into()),\n338\t    }\n339\t}\n340\t\n341\t/// The findings body — the content between the closing frontmatter fence and the `## Handoff Delta`\n342\t/// section, minus heading lines. `None` when the frontmatter fence or the delta section is absent.\n343\t/// Public so the ingest can extract a PRIOR handoff's body to feed `compute_delta` on a re-run.\n344\tpub fn handoff_body(text: &str) -> Option<String> {\n345\t    let after_fm = text.strip_prefix(\"---\\n\")?;\n346\t    let close = after_fm.find(\"\\n---\\n\")?;\n347\t    let rest = &after_fm[close + 5..];\n348\t    let (before_delta, _) = rest.split_once(\"## Handoff Delta\")?;\n349\t    let body: Vec<&str> = before_delta\n350\t        .lines()\n351\t        .map(|l| l.trim())\n352\t        .filter(|l| !l.is_empty() && !l.starts_with('#'))\n353\t        .collect();\n354\t    Some(body.join(\"\\n\"))\n355\t}\n356\t\n357\t/// sha256 of a byte string — the handoff's `source-sha` preimage (the subagent's raw findings), so\n358\t/// a governed handoff is verifiably derived from those exact findings. Shells out (same tool-fallback\n359\t/// order as `verify-closeout.sh#_sha256`) rather than add a crate for one hash; this codebase already\n360\t/// shells to git/sha tools throughout.\n361\tpub fn sha256_hex(bytes: &[u8]) -> Option<String> {\n362\t    let variants: [(&str, &[&str]); 2] = [(\"sha256sum\", &[]), (\"shasum\", &[\"-a\", \"256\"])];\n363\t    for (cmd, args) in variants {\n364\t        let mut child = match Command::new(cmd)\n365\t            .args(args)\n366\t            .stdin(Stdio::piped())\n367\t            .stdout(Stdio::piped())\n368\t            .stderr(Stdio::null())\n369\t            .spawn()\n370\t        {\n371\t            Ok(c) => c,\n372\t            Err(_) => continue,\n373\t        };\n374\t        if let Some(mut stdin) = child.stdin.take() {\n375\t            if stdin.write_all(bytes).is_err() {\n376\t                continue;\n377\t            }\n378\t        }\n379\t        if let Ok(out) = child.wait_with_output() {\n380\t            if out.status.success() {\n381\t                if let Some(h) = String::from_utf8_lossy(&out.stdout)\n382\t                    .split_whitespace()\n383\t                    .next()\n384\t                {\n385\t                    return Some(h.to_string());\n386\t                }\n387\t            }\n388\t        }\n389\t    }\n390\t    None\n391\t}\n392\t\n393\t// ---------------------------------------------------------------------------\n394\t// S112 — the READ side. S109 wrote governed handoffs; S111 proved they come from a real by-name\n395\t// dispatch; nothing read them back, so the fleet's output sat orphaned next to the pipeline it\n396\t// belongs to. Everything below turns a written handoff into something a station can consume.\n397\t// ---------------------------------------------------------------------------\n398\t\n399\t/// What a governed handoff says about itself, read back off disk. Built ONLY from a handoff that\n400\t/// passed `validate_handoff` — a malformed one becomes `HandoffRead::Malformed`, never a `Handoff`\n401\t/// with blank fields, so a broken artifact can never read as a good one (the fail-closed rule,\n402\t/// applied to the reader).\n403\t#[derive(Debug, Clone, PartialEq, Eq)]\n404\tpub struct Handoff {\n405\t    /// The role that produced it (`role:` frontmatter) — e.g. `researcher`.\n406\t    pub role: String,\n407\t    /// The session it belongs to, from the path it was found at (the SoT for placement).\n408\t    pub session: u32,\n409\t    /// Repo-relative path, so a caller can point a human at the file.\n410\t    pub path: String,\n411\t    /// The `agent:` frontmatter — which agent produced the findings.\n412\t    pub agent: String,\n413\t    /// The `captured:` frontmatter — when.\n414\t    pub captured: String,\n415\t    /// The `source-sha:` frontmatter — the hash of the raw findings it was derived from.\n416\t    pub source_sha: String,\n417\t    /// The findings body, already stripped of headings/blank lines by `handoff_body`.\n418\t    pub body: String,\n419\t}\n420\t\n421\timpl Handoff {\n422\t    /// Every non-empty body line, trimmed — the basis for both the inline head and the honest\n423\t    /// \"there is more\" count.\n424\t    fn body_lines(&self) -> Vec<String> {\n425\t        self.body\n426\t            .lines()\n427\t            .map(|l| l.trim().to_string())\n428\t            .filter(|l| !l.is_empty())\n429\t            .collect()\n430\t    }\n431\t\n432\t    /// The first `n` body lines — what a consuming station inlines so the findings are actually in\n433\t    /// front of the reader, not merely referenced by path.\n434\t    pub fn head_lines(&self, n: usize) -> Vec<String> {\n435\t        self.body_lines().into_iter().take(n).collect()\n436\t    }\n437\t\n438\t    /// How many body lines the inline head LEAVES OUT at `n`. A reader who is shown 6 of 40 lines\n439\t    /// must be told so — a truncation that looks like the whole thing is exactly the false green\n440\t    /// this project exists to kill.\n441\t    pub fn omitted_lines(&self, n: usize) -> usize {\n442\t        self.body_lines().len().saturating_sub(n)\n443\t    }\n444\t}\n445\t\n446\t/// The three honest outcomes of looking for a role's handoff. `Absent` is the silent, harmless\n447\t/// case (most sessions have no researcher handoff and must behave exactly as before). `Malformed`\n448\t/// is deliberately NOT silent: a file that exists but fails the contract is a problem to surface,\n449\t/// not to swallow.\n450\t#[derive(Debug, Clone, PartialEq, Eq)]\n451\tpub enum HandoffRead {\n452\t    /// No handoff file for this role/session.\n453\t    Absent,\n454\t    /// A file exists but does not satisfy the DECISION-007 contract. Carries (path, reason).\n455\t    Malformed(String, String),\n456\t    /// A contract-valid handoff.\n457\t    Found(Handoff),\n458\t}\n459\t\n460\t/// Parse handoff TEXT into a `Handoff` (pure — the testable core). `session`/`path` come from where\n461\t/// it was found rather than from the frontmatter: the path is the placement SoT, and trusting a\n462\t/// self-declared `session:` would let a misfiled handoff claim any session it liked.\n463\tpub fn parse_handoff(text: &str, session: u32, path: &str) -> Result<Handoff, String> {\n464\t    validate_handoff(text)?;\n465\t    let body = handoff_body(text).ok_or_else(|| \"handoff has no findings body\".to_string())?;\n466\t    // Every displayed field must come from the FRONTMATTER BLOCK, not merely from somewhere in the\n467\t    // file. `validate_handoff` accepts a `role:` line anywhere (it scans all lines), so without this\n468\t    // a file whose keys sit in the body would parse into a `Handoff` with blank fields and render as\n469\t    // \"  (agent: , captured: )\" — a broken artifact reading as a good one. Fail closed instead.\n470\t    let field = |key: &str| {\n471\t        frontmatter_value(text, key)\n472\t            .ok_or_else(|| format!(\"handoff frontmatter block has no `{key}` value\"))\n473\t    };\n474\t    Ok(Handoff {\n475\t        role: field(\"role:\")?,\n476\t        session,\n477\t        path: path.to_string(),\n478\t        agent: field(\"agent:\")?,\n479\t        captured: field(\"captured:\")?,\n480\t        source_sha: field(\"source-sha:\")?,\n481\t        body,\n482\t    })\n483\t}\n484\t\n485\t/// The value of a frontmatter `key:` line, trimmed. Only the frontmatter block is searched (the\n486\t/// text before the closing `---` fence), so a body line that merely starts with `agent:` cannot\n487\t/// impersonate a frontmatter field.\n488\tfn frontmatter_value(text: &str, key: &str) -> Option<String> {\n489\t    let after_fm = text.strip_prefix(\"---\\n\")?;\n490\t    let close = after_fm.find(\"\\n---\\n\")?;\n491\t    after_fm[..close]\n492\t        .lines()\n493\t        .find_map(|l| l.trim_start().strip_prefix(key))\n494\t        .map(|v| v.trim().to_string())\n495\t        .filter(|v| !v.is_empty())\n496\t}\n497\t\n498\t/// Read one role's governed handoff for `session` back off disk (the module's one narrow read\n499\t/// edge — fs-read-only, no writes, no processes; testable against a tempdir). An unreadable file\n500\t/// is reported as `Malformed`, never silently `Absent`.\n501\tpub fn read_handoff(root: &std::path::Path, role: &Role, session: u32) -> HandoffRead {\n502\t    let rel = role.handoff_rel(session);\n503\t    let path = root.join(&rel);\n504\t    if !path.exists() {\n505\t        return HandoffRead::Absent;\n506\t    }\n507\t    match std::fs::read_to_string(&path) {\n508\t        Err(e) => HandoffRead::Malformed(rel, format!(\"unreadable: {e}\")),\n509\t        Ok(text) => match parse_handoff(&text, session, &rel) {\n510\t            Ok(h) => HandoffRead::Found(h),\n511\t            Err(reason) => HandoffRead::Malformed(rel, reason),\n512\t        },\n513\t    }\n514\t}\n515\t\n516\t/// Every registered role's handoff for `session`, dropping the `Absent` ones. Empty vec = this\n517\t/// session simply had no fleet work, which every caller must treat as normal and silent.\n518\tpub fn read_handoffs(root: &std::path::Path, session: u32) -> Vec<HandoffRead> {\n519\t    ROLES\n520\t        .iter()\n521\t        .map(|r| read_handoff(root, r, session))\n522\t        .filter(|h| !matches!(h, HandoffRead::Absent))\n523\t        .collect()\n524\t}\n525\t\n526\t/// Render read handoffs as the block a consuming station prints: who produced it, when, where it\n527\t/// lives, and the first `head` findings lines INLINE (a path alone is not consumption). Empty\n528\t/// input renders the empty string — absence prints nothing at all.\n529\tpub fn format_handoff_brief(reads: &[HandoffRead], head: usize) -> String {\n530\t    let mut s = String::new();\n531\t    for r in reads {\n532\t        match r {\n533\t            HandoffRead::Absent => {}\n534\t            HandoffRead::Malformed(path, reason) => {\n535\t                s.push_str(&format!(\n536\t                    \"  ⚠ {path} exists but does not satisfy the handoff contract ({reason}) \\\n537\t                     — not used\\n\"\n538\t                ));\n539\t            }\n540\t            HandoffRead::Found(h) => {\n541\t                s.push_str(&format!(\n542\t                    \"  {role} (agent: {agent}, captured: {captured})\\n    {path}\\n\",\n543\t                    role = h.role,\n544\t                    agent = h.agent,\n545\t                    captured = h.captured,\n546\t                    path = h.path,\n547\t                ));\n548\t                for line in h.head_lines(head) {\n549\t                    let clipped: String = line.chars().take(110).collect();\n550\t                    let ell = if line.chars().count() > 110 {\n551\t                        \"…\"\n552\t                    } else {\n553\t                        \"\"\n554\t                    };\n555\t                    s.push_str(&format!(\"    · {clipped}{ell}\\n\"));\n556\t                }\n557\t                // Never let a truncated head read as the whole brief — say how much was left out\n558\t                // and where the rest is. A partial view that looks complete is a false green.\n559\t                let omitted = h.omitted_lines(head);\n560\t                if omitted > 0 {\n561\t                    s.push_str(&format!(\n562\t                        \"    · … {omitted} more line(s) — full findings at {}\\n\",\n563\t                        h.path\n564\t                    ));\n565\t                }\n566\t            }\n567\t        }\n568\t    }\n569\t    s\n570\t}\n571\t\n572\t#[cfg(test)]\n573\tmod tests {\n574\t    use super::*;\n575\t\n576\t    #[test]\n577\t    fn resolve_role_knows_researcher_and_fails_closed_on_unknown() {\n578\t        assert!(resolve_role(\"researcher\").is_some());\n579\t        assert_eq!(resolve_role(\"researcher\").unwrap().name, \"researcher\");\n580\t        // Unknown role → None (the caller fails closed). Case-sensitive on the stable key.\n581\t        assert!(resolve_role(\"Researcher\").is_none());\n582\t        assert!(resolve_role(\"coder\").is_none());\n583\t        assert!(resolve_role(\"\").is_none());\n584\t        assert!(known_roles().contains(\"researcher\"));\n585\t    }\n586\t\n587\t    #[test]\n588\t    fn handoff_and_subagent_paths_are_conventional() {\n589\t        let r = resolve_role(\"researcher\").unwrap();\n590\t        assert_eq!(r.handoff_rel(109), \".ai/handoffs/session-109-researcher.md\");\n591\t        assert_eq!(r.handoff_rel(9), \".ai/handoffs/session-09-researcher.md\");\n592\t        assert_eq!(r.subagent_rel(), \".claude/agents/researcher.md\");\n593\t    }\n594\t\n595\t    #[test]\n596\t    fn render_subagent_definition_is_valid_claude_agent_from_one_source() {\n597\t        let r = resolve_role(\"researcher\").unwrap();\n598\t        let def = render_subagent_definition(r);\n599\t        // Claude Code subagent frontmatter: name + description, opening `---` fence.\n600\t        assert!(def.starts_with(\"---\\n\"));\n601\t        assert!(def.contains(\"name: researcher\"));\n602\t        assert!(def.contains(\"description:\"));\n603\t        assert!(def.contains(\"tools:\"));\n604\t        // The body is the CANONICAL system prompt (no drift — same string the role carries).\n605\t        assert!(def.contains(\"You are the Researcher\"));\n606\t        assert!(def.contains(r.system_prompt));\n607\t        // It points at the governed handoff, and tells the subagent NOT to author frontmatter.\n608\t        assert!(def.contains(\".ai/handoffs/session-<NN>-researcher.md\"));\n609\t        assert!(def.contains(\"vajra next --role researcher --from\"));\n610\t    }\n611\t\n612\t    #[test]\n613\t    fn compute_delta_new_vs_rerun() {\n614\t        let r = resolve_role(\"researcher\").unwrap();\n615\t        let d0 = compute_delta(r, None, \"abcde\");\n616\t        assert!(d0.contains(\"`+` new\"));\n617\t        assert!(d0.contains(\"5 bytes\"));\n618\t        let d1 = compute_delta(r, Some(\"ab\"), \"abcde\");\n619\t        assert!(d1.contains(\"`~` re-run\"));\n620\t        assert!(d1.contains(\"5 bytes now vs 2 bytes\"));\n621\t    }\n622\t\n623\t    /// S114 — the delta names the role that produced it. Hardcoded to \"researcher\" before a second\n624\t    /// role existed, so a Reviewer handoff would have carried the Researcher's name in its own\n625\t    /// tracked delta. Asserted for EVERY registered role, so a third role cannot regress it.\n626\t    #[test]\n627\t    fn compute_delta_names_the_producing_role_not_a_hardcoded_one() {\n628\t        for role in ROLES {\n629\t            let new = compute_delta(role, None, \"findings\");\n630\t            let rerun = compute_delta(role, Some(\"prior\"), \"findings\");\n631\t            assert!(\n632\t                new.contains(&format!(\"first {} handoff\", role.name)),\n633\t                \"new-delta does not name {}: {new}\",\n634\t                role.name\n635\t            );\n636\t            assert!(\n637\t                rerun.contains(&format!(\"{} handoff replaced\", role.name)),\n638\t                \"re-run delta does not name {}: {rerun}\",\n639\t                role.name\n640\t            );\n641\t            // A non-researcher role must not carry the Researcher's name anywhere in its delta.\n642\t            if role.name != \"researcher\" {\n643\t                assert!(\n644\t                    !new.contains(\"researcher\"),\n645\t                    \"{} leaked 'researcher'\",\n646\t                    role.name\n647\t                );\n648\t                assert!(\n649\t                    !rerun.contains(\"researcher\"),\n650\t                    \"{} leaked 'researcher'\",\n651\t                    role.name\n652\t                );\n653\t            }\n654\t        }\n655\t    }\n656\t\n657\t    /// S114 — the SECOND role exists, is keyed to avoid the Reviewer-STATION collision, and carries\n658\t    /// the adversarial contract. This fails if the role is removed, renamed to `reviewer`, or\n659\t    /// hollowed out to a stub prompt.\n660\t    #[test]\n661\t    fn fidelity_reviewer_is_registered_with_a_non_colliding_key() {\n662\t        assert_eq!(\n663\t            ROLES.len(),\n664\t            3,\n665\t            \"the fleet ships exactly three roles at S116\"\n666\t        );\n667\t        let r = resolve_role(\"fidelity-reviewer\").expect(\"the second role is registered\");\n668\t        // The collision resolution, asserted: the key is NOT the bare station word.\n669\t        assert!(resolve_role(\"reviewer\").is_none());\n670\t        assert!(known_roles().contains(\"fidelity-reviewer\"));\n671\t        assert_eq!(\n672\t            r.handoff_rel(114),\n673\t            \".ai/handoffs/session-114-fidelity-reviewer.md\"\n674\t        );\n675\t        assert_eq!(r.subagent_rel(), \".claude/agents/fidelity-reviewer.md\");\n676\t        // The contract, not a stub: the three grades, the fakest green, and no self-certification.\n677\t        for must in [\n678\t            \"SHIPPED / PARTIAL / NOT-BUILT\",\n679\t            \"FAKEST GREEN\",\n680\t            \"Never self-certify\",\n681\t            \"PRE-STAGE INPUT\",\n682\t            \"sessions/session-NN-review.md\",\n683\t        ] {\n684\t            assert!(\n685\t                r.system_prompt.contains(must),\n686\t                \"reviewer prompt is missing {must:?}\"\n687\t            );\n688\t        }\n689\t    }\n690\t\n691\t    /// S116 — the THIRD role exists, is keyed to avoid the Planner-STATION collision (the same\n692\t    /// collision the Reviewer hit at S114, now hit a second time), and carries the `covers: N`\n693\t    /// contract the Planner station's own gate parses and grades. Fails if the role is removed,\n694\t    /// renamed to `planner`, or hollowed out to a stub prompt.\n695\t    #[test]\n696\t    fn plan_advisor_is_registered_with_a_non_colliding_key() {\n697\t        let r = resolve_role(\"plan-advisor\").expect(\"the third role is registered\");\n698\t        // The collision resolution, asserted: the key is NOT the bare station word.\n699\t        assert!(resolve_role(\"planner\").is_none());\n700\t        assert!(known_roles().contains(\"plan-advisor\"));\n701\t        assert_eq!(\n702\t            r.handoff_rel(116),\n703\t            \".ai/handoffs/session-116-plan-advisor.md\"\n704\t        );\n705\t        assert_eq!(r.subagent_rel(), \".claude/agents/plan-advisor.md\");\n706\t        // The contract, not a stub: proposes, cites `covers: N`, never authors the plan of record.\n707\t        for must in [\n708\t            \"covers: N\",\n709\t            \"covers: N, M\",\n710\t            \"propose, the author records\",\n711\t            \"no Write or Edit tool\",\n712\t            \"never the plan of record\",\n713\t        ] {\n714\t            assert!(\n715\t                r.system_prompt.contains(must),\n716\t                \"plan-advisor prompt is missing {must:?}\"\n717\t            );\n718\t        }\n719\t    }\n720\t\n721\t    /// S114, cold-review finding — the role brief is NOT the only statement of this contract:\n722\t    /// `reviewer/SKILL.md` is the canonical 100+ line version, scaffolded into every repo by the\n723\t    /// same `vajra init`. Two hand-maintained statements of one job is exactly the drift this\n724\t    /// module exists to prevent, and the dangerous half is the OUTPUT SHAPE: a dispatched agent\n725\t    /// obeying only the role brief could return a verdict the closeout gate then REJECTS.\n726\t    ///\n727\t    /// So this test binds them: every token `verify-closeout.sh` requires of a landed review must\n728\t    /// appear in BOTH files. It reads the skill off disk on purpose — a change to the canonical\n729\t    /// contract that the role brief does not follow turns this red.\n730\t    #[test]\n731\t    fn the_role_brief_carries_the_output_shape_the_closeout_gate_requires() {\n732\t        let skill =\n733\t            std::fs::read_to_string(concat!(env!(\"CARGO_MANIFEST_DIR\"), \"/reviewer/SKILL.md\"))\n734\t                .expect(\"reviewer/SKILL.md is the canonical contract and must exist\");\n735\t        let brief = resolve_role(\"fidelity-reviewer\").unwrap().system_prompt;\n736\t\n737\t        // The gate counts verdict words ONLY on `|`-delimited rows (`check_fidelity_review`), so a\n738\t        // brief that says \"a table\" without saying which shape sends the agent to write bullets the\n739\t        // gate then rejects — cold-review pass 2 wrote exactly that review and watched it BLOCK.\n740\t        assert!(\n741\t            brief.contains(\"MARKDOWN TABLE\") && brief.contains(\"`|`-delimited rows\"),\n742\t            \"the role brief does not state the pipe-row table shape the gate actually counts\"\n743\t        );\n744\t\n745\t        // The three things the gate FAILS a review for missing (verify-closeout.sh).\n746\t        for token in [\n747\t            \"SHIPPED\",\n748\t            \"PARTIAL\",\n749\t            \"NOT-BUILT\",\n750\t            \"**Verdict:**\",\n751\t            \"of N SHIPPED\",\n752\t        ] {\n753\t            // Positive control: the canonical contract really does require it. Without this, a\n754\t            // typo'd token would make the assertion below vacuously about nothing.\n755\t            assert!(\n756\t                skill.contains(token) || skill.contains(&token.replace(\"of N \", \"X of N \")),\n757\t                \"positive control failed: reviewer/SKILL.md does not mention {token:?} — \\\n758\t                 fix this test's tokens, do not weaken it\"\n759\t            );\n760\t            assert!(\n761\t                brief.contains(token),\n762\t                \"the role brief omits {token:?}, which the closeout gate requires of the landed \\\n763\t                 review — a dispatched agent obeying only this brief would produce a REJECTED file\"\n764\t            );\n765\t        }\n766\t        // And the brief must point at the canonical contract by name, so it reads as a summary of\n767\t        // one source rather than a rival second source.\n768\t        assert!(\n769\t            brief.contains(\"reviewer/SKILL.md\"),\n770\t            \"the role brief does not name reviewer/SKILL.md as canonical\"\n771\t        );\n772\t    }\n773\t\n774\t    /// S114 — every role is read-only, and the tool grant is the ROLE's, not a hardcoded list.\n775\t    /// The Reviewer gets strictly local reads: no web, no Bash.\n776\t    #[test]\n777\t    fn every_role_is_read_only_and_renders_its_own_tools() {\n778\t        for role in ROLES {\n779\t            let def = render_subagent_definition(role);\n780\t            assert!(\n781\t                def.contains(&format!(\"tools: {}\", role.tools)),\n782\t                \"{} does not render its own tools\",\n783\t                role.name\n784\t            );\n785\t            for forbidden in [\"Write\", \"Edit\", \"Bash\", \"NotebookEdit\"] {\n786\t                assert!(\n787\t                    !role.tools.contains(forbidden),\n788\t                    \"{} grants the write/exec tool {forbidden}\",\n789\t                    role.name\n790\t                );\n791\t            }\n792\t        }\n793\t        let rev = resolve_role(\"fidelity-reviewer\").unwrap();\n794\t        assert_eq!(rev.tools, \"Read, Grep, Glob\");\n795\t        let res = resolve_role(\"researcher\").unwrap();\n796\t        assert_ne!(res.tools, rev.tools, \"the tool grant must be per-role\");\n797\t        let plan = resolve_role(\"plan-advisor\").unwrap();\n798\t        assert_eq!(plan.tools, \"Read, Grep, Glob\");\n799\t        assert_ne!(res.tools, plan.tools, \"the tool grant must be per-role\");\n800\t    }\n801\t\n802\t    /// S114 — the rendering is generic: every registered role produces a valid subagent definition\n803\t    /// pointing at ITS OWN handoff path and ITS OWN `vajra next --role` command line.\n804\t    #[test]\n805\t    fn render_subagent_definition_is_correct_for_every_registered_role() {\n806\t        for role in ROLES {\n807\t            let def = render_subagent_definition(role);\n808\t            assert!(def.starts_with(\"---\\n\"));\n809\t            assert!(def.contains(&format!(\"name: {}\", role.name)));\n810\t            assert!(def.contains(role.description));\n811\t            assert!(def.contains(role.system_prompt));\n812\t            assert!(def.contains(&format!(\".ai/handoffs/session-<NN>-{}.md\", role.name)));\n813\t            assert!(def.contains(&format!(\"vajra next --role {} --from\", role.name)));\n814\t        }\n815\t    }\n816\t\n817\t    #[test]\n818\t    fn format_handoff_carries_the_full_contract_and_validates() {\n819\t        let r = resolve_role(\"researcher\").unwrap();\n820\t        let delta = compute_delta(r, None, \"the findings\");\n821\t        let h = format_handoff(\n822\t            r,\n823\t            109,\n824\t            \"claude-code-subagent\",\n825\t            \"a\".repeat(64).as_str(),\n826\t            \"2026-08-02T00:00:00Z\",\n827\t            None,\n828\t            \"the findings\",\n829\t            &delta,\n830\t        );\n831\t        assert!(h.contains(\"role: researcher\"));\n832\t        assert!(h.contains(\"session: 109\"));\n833\t        assert!(h.contains(\"agent: claude-code-subagent\"));\n834\t        assert!(h.contains(\"source-sha: aaaa\"));\n835\t        assert!(h.contains(\"captured: 2026-08-02T00:00:00Z\"));\n836\t        assert!(h.contains(\"cost_usd: null\"));\n837\t        assert!(h.contains(\"# Researcher handoff — session 109\"));\n838\t        assert!(h.contains(\"the findings\"));\n839\t        assert!(h.contains(\"## Handoff Delta\"));\n840\t        assert!(validate_handoff(&h).is_ok());\n841\t    }\n842\t\n843\t    #[test]\n844\t    fn format_handoff_renders_known_cost() {\n845\t        let r = resolve_role(\"researcher\").unwrap();\n846\t        let h = format_handoff(\n847\t            r,\n848\t            5,\n849\t            \"claude-code-subagent\",\n850\t            \"b\".repeat(64).as_str(),\n851\t            \"2026-08-02T00:00:00Z\",\n852\t            Some(0.0031),\n853\t            \"body\",\n854\t            \"- `+` new\",\n855\t        );\n856\t        assert!(h.contains(\"cost_usd: 0.003100\"));\n857\t        assert!(validate_handoff(&h).is_ok());\n858\t    }\n859\t\n860\t    #[test]\n861\t    fn validate_handoff_fails_closed_on_each_missing_piece() {\n862\t        let r = resolve_role(\"researcher\").unwrap();\n863\t        let good = format_handoff(\n864\t            r,\n865\t            109,\n866\t            \"claude-code-subagent\",\n867\t            \"c\".repeat(64).as_str(),\n868\t            \"t\",\n869\t            Some(0.1),\n870\t            \"real body\",\n871\t            \"- `+` new\",\n872\t        );\n873\t        assert!(validate_handoff(&good).is_ok());\n874\t\n875\t        // Missing a frontmatter key (drop the `agent:` line).\n876\t        let no_agent = good\n877\t            .lines()\n878\t            .filter(|l| !l.trim_start().starts_with(\"agent:\"))\n879\t            .collect::<Vec<_>>()\n880\t            .join(\"\\n\");\n881\t        assert!(validate_handoff(&no_agent).is_err());\n882\t\n883\t        // Missing the delta section.\n884\t        let no_delta = good.replace(\"## Handoff Delta\", \"## Something Else\");\n885\t        assert!(validate_handoff(&no_delta).is_err());\n886\t\n887\t        // Empty body (frontmatter + delta only, heading but no findings).\n888\t        let empty_body = \"---\\nrole: researcher\\nsession: 109\\nagent: claude-code-subagent\\n\\\n889\t             source-sha: cccc\\ncaptured: t\\ncost_usd: 0.1\\n---\\n\\n\\\n890\t             # Researcher handoff — session 109\\n\\n## Handoff Delta\\n- `+` new\\n\";\n891\t        assert!(validate_handoff(empty_body).is_err());\n892\t\n893\t        // Not a handoff at all.\n894\t        assert!(validate_handoff(\"just some notes\").is_err());\n895\t    }\n896\t\n897\t    #[test]\n898\t    fn sha256_hex_is_deterministic_64_hex() {\n899\t        let a = sha256_hex(b\"hello\").expect(\"sha available\");\n900\t        let b = sha256_hex(b\"hello\").unwrap();\n901\t        assert_eq!(a, b);\n902\t        assert_eq!(a.len(), 64);\n903\t        assert!(a.chars().all(|c| c.is_ascii_hexdigit()));\n904\t        assert_eq!(\n905\t            a,\n906\t            \"2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824\"\n907\t        );\n908\t    }\n909\t\n910\t    // ---- S112: the read side ------------------------------------------------------------\n911\t\n912\t    /// A contract-valid handoff, written where `read_handoff` will look for it.\n913\t    fn write_handoff(root: &std::path::Path, session: u32, body: &str) -> String {\n914\t        let r = resolve_role(\"researcher\").unwrap();\n915\t        let text = format_handoff(\n916\t            r,\n917\t            session,\n918\t            \"claude-code-subagent\",\n919\t            &\"d\".repeat(64),\n920\t            \"2026-08-04T00:00:00Z\",\n921\t            None,\n922\t            body,\n923\t            &compute_delta(r, None, body),\n924\t        );\n925\t        let rel = r.handoff_rel(session);\n926\t        let path = root.join(&rel);\n927\t        std::fs::create_dir_all(path.parent().unwrap()).unwrap();\n928\t        std::fs::write(&path, &text).unwrap();\n929\t        text\n930\t    }\n931\t\n932\t    #[test]\n933\t    fn parse_handoff_round_trips_what_format_handoff_wrote() {\n934\t        let r = resolve_role(\"researcher\").unwrap();\n935\t        let text = format_handoff(\n936\t            r,\n937\t            112,\n938\t            \"claude-code-subagent\",\n939\t            &\"e\".repeat(64),\n940\t            \"2026-08-04T00:00:00Z\",\n941\t            Some(0.25),\n942\t            \"line one\\nline two\",\n943\t            \"- `+` new\",\n944\t        );\n945\t        let h = parse_handoff(&text, 112, \".ai/handoffs/session-112-researcher.md\").unwrap();\n946\t        assert_eq!(h.role, \"researcher\");\n947\t        assert_eq!(h.session, 112);\n948\t        assert_eq!(h.agent, \"claude-code-subagent\");\n949\t        assert_eq!(h.captured, \"2026-08-04T00:00:00Z\");\n950\t        assert_eq!(h.source_sha, \"e\".repeat(64));\n951\t        assert_eq!(h.head_lines(1), vec![\"line one\".to_string()]);\n952\t        assert_eq!(h.head_lines(9), vec![\"line one\", \"line two\"]);\n953\t    }\n954\t\n955\t    #[test]\n956\t    fn parse_handoff_trusts_the_path_not_a_self_declared_session() {\n957\t        // Frontmatter claims session 999; it was found at session 112's path. The path wins —\n958\t        // a misfiled handoff must not be able to claim a session it is not in.\n959\t        let r = resolve_role(\"researcher\").unwrap();\n960\t        let text = format_handoff(\n961\t            r,\n962\t            999,\n963\t            \"a\",\n964\t            &\"f\".repeat(64),\n965\t            \"t\",\n966\t            None,\n967\t            \"findings\",\n968\t            \"- `+` new\",\n969\t        );\n970\t        let h = parse_handoff(&text, 112, \".ai/handoffs/session-112-researcher.md\").unwrap();\n971\t        assert_eq!(h.session, 112);\n972\t    }\n973\t\n974\t    /// A file whose contract keys live in the BODY rather than the frontmatter block passes\n975\t    /// `validate_handoff` (it scans every line) but must NOT parse into a `Handoff` with blank\n976\t    /// fields — that would render as \"(agent: , captured: )\" and read as a good artifact.\n977\t    #[test]\n978\t    fn parse_handoff_fails_closed_when_a_key_is_not_in_the_frontmatter_block() {\n979\t        let text = \"---\\nrole: researcher\\nsession: 1\\nsource-sha: x\\ncaptured: t\\n\\\n980\t             cost_usd: null\\n---\\n\\n# H\\n\\nagent: down-here-not-in-frontmatter\\n\\n\\\n981\t             ## Handoff Delta\\n- d\\n\";\n982\t        // The legacy contract check passes — every key appears SOMEWHERE.\n983\t        assert!(validate_handoff(text).is_ok());\n984\t        // The reader does not: `agent:` is not in the frontmatter block.\n985\t        let err = parse_handoff(text, 1, \"p\").unwrap_err();\n986\t        assert!(err.contains(\"agent:\"), \"got: {err}\");\n987\t    }\n988\t\n989\t    #[test]\n990\t    fn head_lines_truncation_is_disclosed_not_silent() {\n991\t        let tmp = tempfile::tempdir().unwrap();\n992\t        write_handoff(tmp.path(), 112, \"l1\\nl2\\nl3\\nl4\\nl5\");\n993\t        let out = format_handoff_brief(&read_handoffs(tmp.path(), 112), 2);\n994\t        assert!(out.contains(\"l1\"));\n995\t        assert!(out.contains(\"l2\"));\n996\t        assert!(!out.contains(\"l5\"));\n997\t        // The reader is TOLD what was left out, and where the rest lives.\n998\t        assert!(out.contains(\"3 more line(s)\"), \"got: {out}\");\n999\t        assert!(out.contains(\".ai/handoffs/session-112-researcher.md\"));\n1000\t\n1001\t        // Nothing omitted -> no \"more lines\" noise.\n1002\t        let full = format_handoff_brief(&read_handoffs(tmp.path(), 112), 99);\n1003\t        assert!(!full.contains(\"more line(s)\"));\n1004\t    }\n1005\t\n1006\t    #[test]\n1007\t    fn frontmatter_value_ignores_a_body_line_that_looks_like_a_key() {\n1008\t        let text = \"---\\nrole: researcher\\nsession: 1\\nagent: real-agent\\nsource-sha: x\\n\\\n1009\t             captured: t\\ncost_usd: null\\n---\\n\\n# H\\n\\nagent: impostor\\n\\n## Handoff Delta\\n- d\\n\";\n1010\t        let h = parse_handoff(text, 1, \"p\").unwrap();\n1011\t        assert_eq!(h.agent, \"real-agent\");\n1012\t    }\n1013\t\n1014\t    #[test]\n1015\t    fn read_handoff_absent_found_and_malformed() {\n1016\t        let tmp = tempfile::tempdir().unwrap();\n1017\t        let root = tmp.path();\n1018\t        let r = resolve_role(\"researcher\").unwrap();\n1019\t\n1020\t        // Absent — the silent, harmless case every no-fleet session must hit.\n1021\t        assert_eq!(read_handoff(root, r, 112), HandoffRead::Absent);\n1022\t        assert!(read_handoffs(root, 112).is_empty());\n1023\t\n1024\t        // Found.\n1025\t        write_handoff(root, 112, \"the finding that matters\");\n1026\t        match read_handoff(root, r, 112) {\n1027\t            HandoffRead::Found(h) => {\n1028\t                assert_eq!(h.role, \"researcher\");\n1029\t                assert_eq!(h.path, \".ai/handoffs/session-112-researcher.md\");\n1030\t                assert!(h.body.contains(\"the finding that matters\"));\n1031\t            }\n1032\t            other => panic!(\"expected Found, got {other:?}\"),\n1033\t        }\n1034\t        assert_eq!(read_handoffs(root, 112).len(), 1);\n1035\t\n1036\t        // Malformed — present but off-contract. NOT silent: it must name why.\n1037\t        std::fs::write(\n1038\t            root.join(r.handoff_rel(112)),\n1039\t            \"not a handoff at all, just notes\\n\",\n1040\t        )\n1041\t        .unwrap();\n1042\t        match read_handoff(root, r, 112) {\n1043\t            HandoffRead::Malformed(path, reason) => {\n1044\t                assert!(path.ends_with(\"session-112-researcher.md\"));\n1045\t                assert!(!reason.is_empty());\n1046\t            }\n1047\t            other => panic!(\"expected Malformed, got {other:?}\"),\n1048\t        }\n1049\t    }\n1050\t\n1051\t    #[test]\n1052\t    fn format_handoff_brief_inlines_findings_and_is_empty_when_absent() {\n1053\t        // Absence renders NOTHING — a session with no fleet work looks exactly as it did before.\n1054\t        assert_eq!(format_handoff_brief(&[], 3), \"\");\n1055\t        assert_eq!(format_handoff_brief(&[HandoffRead::Absent], 3), \"\");\n1056\t\n1057\t        let tmp = tempfile::tempdir().unwrap();\n1058\t        write_handoff(\n1059\t            tmp.path(),\n1060\t            112,\n1061\t            \"first finding\\nsecond finding\\nthird finding\",\n1062\t        );\n1063\t        let out = format_handoff_brief(&read_handoffs(tmp.path(), 112), 2);\n1064\t        assert!(out.contains(\"researcher\"));\n1065\t        assert!(out.contains(\"claude-code-subagent\"));\n1066\t        assert!(out.contains(\".ai/handoffs/session-112-researcher.md\"));\n1067\t        // The findings are INLINE, not just pointed at — and clipped to `head`.\n1068\t        assert!(out.contains(\"first finding\"));\n1069\t        assert!(out.contains(\"second finding\"));\n1070\t        assert!(!out.contains(\"third finding\"));\n1071\t\n1072\t        // A malformed handoff is surfaced, never swallowed.\n1073\t        let bad = HandoffRead::Malformed(\"p.md\".into(), \"missing frontmatter key `role:`\".into());\n1074\t        let out = format_handoff_brief(&[bad], 2);\n1075\t        assert!(out.contains(\"p.md\"));\n1076\t        assert!(out.contains(\"not used\"));\n1077\t    }\n1078\t}\n1079\t"}]},"uuid":"2d1aa18e-ba5c-4cef-8704-8deaf95d0567","timestamp":"2026-08-11T12:21:21.408Z","sourceToolAssistantUUID":"b51d5e2a-674b-4401-80bf-a13d52499590","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/suman/playground/vajra","sessionId":"87bcd7e1-22ce-4cfb-b4a3-536c21c126e7","version":"2.1.222","gitBranch":"session-117-plan-advisor-dispatch"}
+{"parentUuid":"c1b1d951-b99a-44e5-8e6b-1cf6ecf9409f","isSidechain":true,"promptId":"debef159-52a1-43ee-a9e4-e943af52f8db","agentId":"a554e0bd77d8cce41","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RRE1uAMTpPRKgEz6r3qQUx","type":"tool_result","content":"1\tuse anyhow::{bail, Context, Result};\n2\tuse std::env;\n3\tuse std::fs;\n4\tuse std::io::{self, BufRead, Read as _, Write as _};\n5\tuse std::path::{Path, PathBuf};\n6\tuse std::process::Command;\n7\t\n8\tuse crate::analyst;\n9\tuse crate::architect;\n10\tuse crate::coder;\n11\tuse crate::demoer;\n12\tuse crate::dogfood;\n13\tuse crate::fleet;\n14\tuse crate::maturity::{read_maturity, MaturityLevel};\n15\tuse crate::planner;\n16\tuse crate::qa;\n17\tuse crate::releaser;\n18\tuse crate::stations;\n19\t\n20\tconst PACKET_FILES: &[&str] = &[\n21\t    \".ai/AGENTS.md\",\n22\t    \".ai/SESSION\",\n23\t    \".ai/SESSION-BOOT.md\",\n24\t    \".ai/TASK.md\",\n25\t    \".ai/STATE.md\",\n26\t    \".ai/CONSTRAINTS.yaml\",\n27\t    \".ai/KNOWLEDGE.md\",\n28\t    \".ai/ROADMAP.md\",\n29\t];\n30\t\n31\tpub fn run(args: &[String]) -> Result<()> {\n32\t    // The Analyst stage (S54) rides `vajra next` — no 8th top-level command (max-7 cap).\n33\t    if let Some(i) = args.iter().position(|a| a == \"--scaffold\") {\n34\t        return run_scaffold(args.get(i + 1), args.get(i + 2));\n35\t    }\n36\t    if let Some(i) = args.iter().position(|a| a == \"--validate\") {\n37\t        return run_validate(args.get(i + 1));\n38\t    }\n39\t    if let Some(i) = args.iter().position(|a| a == \"--check-options\") {\n40\t        return run_check_options(args.get(i + 1));\n41\t    }\n42\t    // The Planner stage (S64) also rides `vajra next` — no 8th command.\n43\t    if let Some(i) = args.iter().position(|a| a == \"--plan\") {\n44\t        return run_plan(args.get(i + 1));\n45\t    }\n46\t    if let Some(i) = args.iter().position(|a| a == \"--check-plan\") {\n47\t        return run_check_plan(args.get(i + 1));\n48\t    }\n49\t    // The Architect stage (S67) also rides `vajra next` — no 8th command.\n50\t    if let Some(i) = args.iter().position(|a| a == \"--design\") {\n51\t        return run_design(args.get(i + 1));\n52\t    }\n53\t    if let Some(i) = args.iter().position(|a| a == \"--check-design\") {\n54\t        return run_check_design(args.get(i + 1));\n55\t    }\n56\t    // The Coder stage (S68) also rides `vajra next` — no 8th command.\n57\t    if let Some(i) = args.iter().position(|a| a == \"--exec\") {\n58\t        return run_exec(args.get(i + 1));\n59\t    }\n60\t    if let Some(i) = args.iter().position(|a| a == \"--check-exec\") {\n61\t        return run_check_exec(args.get(i + 1));\n62\t    }\n63\t    // The QA stage (S69) also rides `vajra next` — no 8th command.\n64\t    if let Some(i) = args.iter().position(|a| a == \"--qa\") {\n65\t        return run_qa(args.get(i + 1));\n66\t    }\n67\t    if let Some(i) = args.iter().position(|a| a == \"--check-qa\") {\n68\t        return run_check_qa(args.get(i + 1));\n69\t    }\n70\t    // The Demo-er stage (S71) also rides `vajra next` — no 8th command.\n71\t    if let Some(i) = args.iter().position(|a| a == \"--demo\") {\n72\t        return run_demo(args.get(i + 1));\n73\t    }\n74\t    if let Some(i) = args.iter().position(|a| a == \"--check-demo\") {\n75\t        return run_check_demo(args.get(i + 1));\n76\t    }\n77\t    // The Releaser stage (S72) also rides `vajra next` — no 8th command.\n78\t    if let Some(i) = args.iter().position(|a| a == \"--release\") {\n79\t        return run_release(args.get(i + 1));\n80\t    }\n81\t    if let Some(i) = args.iter().position(|a| a == \"--check-release\") {\n82\t        return run_check_release(args.get(i + 1));\n83\t    }\n84\t    if args.iter().any(|a| a == \"--intake\") {\n85\t        return run_intake();\n86\t    }\n87\t    // The payload counter (S74) rides `vajra next` — no 8th command. Read-only, nothing executes.\n88\t    if let Some(i) = args.iter().position(|a| a == \"--stations\") {\n89\t        return run_stations(args.get(i + 1));\n90\t    }\n91\t    // The dogfood-staleness query (S91) rides `vajra next` — no 8th command. Read-only.\n92\t    if args.iter().any(|a| a == \"--dogfood-age\") {\n93\t        return run_dogfood_age();\n94\t    }\n95\t    // The fleet's handoff governance (S109, DECISION-007) rides `vajra next` — no 8th command.\n96\t    if let Some(i) = args.iter().position(|a| a == \"--role\") {\n97\t        return run_role_handoff(args.get(i + 1), args);\n98\t    }\n99\t\n100\t    if args.iter().any(|a| a == \"--advance\") {\n101\t        run_advance()\n102\t    } else {\n103\t        run_dump()\n104\t    }\n105\t}\n106\t\n107\t/// `vajra next --intake` — the Analyst's INTAKE step (S62 / J1): surface the real inputs (prior\n108\t/// `.ai/SESSION` + the ROADMAP \"Next builds\" block) so a human authors the next job from context,\n109\t/// not a bare slug. Read-only; the binary surfaces, it does not author.\n110\tfn run_intake() -> Result<()> {\n111\t    let root = repo_root()?;\n112\t    // S112: the CURRENT session's governed fleet handoffs are intake too — the branch names the\n113\t    // session, `.ai/SESSION` is the fallback (`current_session`). Absent handoffs print nothing.\n114\t    let session = current_session(&root);\n115\t    print!(\n116\t        \"{}\",\n117\t        analyst::format_intake(&analyst::gather_intake(&root, session))\n118\t    );\n119\t    Ok(())\n120\t}\n121\t\n122\t/// `vajra next --stations NN` — the payload counter (S74): print, per governed station, whether\n123\t/// session NN's prompt DEMONSTRABLY passed it (PASSED / ABSENT) plus the derived `K of 8`. Each\n124\t/// verdict is read from that station's OWN classifier — never a self-asserted digit. Read-only:\n125\t/// nothing executes (the two LIVE stations are read statically). This retires the S25/S60/S65/S70\n126\t/// meta-gap — \"did the PIPELINE advance?\" becomes a measured question. Always exits 0 (a report,\n127\t/// not a gate).\n128\tfn run_stations(nn: Option<&String>) -> Result<()> {\n129\t    let session = parse_session(nn, \"--stations\")?;\n130\t    let root = repo_root()?;\n131\t    print!(\n132\t        \"{}\",\n133\t        stations::format_station_report(&stations::station_report(&root, session))\n134\t    );\n135\t    Ok(())\n136\t}\n137\t\n138\t/// `vajra next --dogfood-age` — the live dogfood-staleness query (S91): scan\n139\t/// `sessions/session-NN-artifacts/` for the most recent real `vajra claude` run, derive its date\n140\t/// from git (not from STATE.md), and report sessions-elapsed + calendar-days-elapsed. Always\n141\t/// exits 0 (a report, not a gate).\n142\tfn run_dogfood_age() -> Result<()> {\n143\t    let root = repo_root()?;\n144\t    let session_str =\n145\t        fs::read_to_string(root.join(\".ai/SESSION\")).context(\"failed to read .ai/SESSION\")?;\n146\t    let current: u32 = session_str\n147\t        .trim()\n148\t        .parse()\n149\t        .context(\".ai/SESSION is not a valid integer\")?;\n150\t    let report = dogfood::dogfood_age(&root, current);\n151\t    print!(\"{}\", dogfood::format_dogfood_age(current, report.as_ref()));\n152\t    Ok(())\n153\t}\n154\t\n155\t/// `vajra next --role <name> --from <findings-file>` — the fleet's handoff governance (S109,\n156\t/// DECISION-007). A native Claude Code subagent (scaffolded by `vajra init` from the canonical\n157\t/// `fleet::ROLES`) returns a findings brief; Vajra wraps it into a delta-tracked, validated handoff\n158\t/// in the `.ai/` spine. Fails closed on: unknown role · missing `--from` · missing/empty findings ·\n159\t/// a handoff that would not validate. `--from -` reads findings from stdin.\n160\tfn run_role_handoff(name: Option<&String>, args: &[String]) -> Result<()> {\n161\t    let name = name.context(\"usage: vajra next --role <name> --from <findings-file>\")?;\n162\t    let role = fleet::resolve_role(name).ok_or_else(|| {\n163\t        anyhow::anyhow!(\n164\t            \"unknown role {name:?} — known roles: {}. (a new role is a separate decision, \\\n165\t             DECISION-007 — the fleet does not grow by typo.)\",\n166\t            fleet::known_roles()\n167\t        )\n168\t    })?;\n169\t    let from = flag_value(args, \"--from\")\n170\t        .context(\"--role needs --from <findings-file> (or `--from -`)\")?;\n171\t    let findings = read_findings(&from)?;\n172\t    if findings.trim().is_empty() {\n173\t        bail!(\"findings are empty — nothing to record (fail closed)\");\n174\t    }\n175\t    let root = repo_root()?;\n176\t    let session = current_session(&root)\n177\t        .context(\"could not determine the session (no session-NN branch and no .ai/SESSION)\")?;\n178\t\n179\t    let handoff_rel = role.handoff_rel(session);\n180\t    let handoff_path = root.join(&handoff_rel);\n181\t    if let Some(parent) = handoff_path.parent() {\n182\t        fs::create_dir_all(parent).with_context(|| format!(\"mkdir {}\", parent.display()))?;\n183\t    }\n184\t    let prior_body = fs::read_to_string(&handoff_path)\n185\t        .ok()\n186\t        .and_then(|p| fleet::handoff_body(&p));\n187\t    let body = findings.trim();\n188\t    let source_sha =\n189\t        fleet::sha256_hex(body.as_bytes()).unwrap_or_else(|| \"unavailable\".to_string());\n190\t    let delta = fleet::compute_delta(role, prior_body.as_deref(), body);\n191\t    let handoff = fleet::format_handoff(\n192\t        role,\n193\t        session,\n194\t        // A subagent's cost rolls into the parent session receipt — recorded as `null` here (S77\n195\t        // honest null), with the session total disclosed in the summary.\n196\t        \"claude-code-subagent\",\n197\t        &source_sha,\n198\t        &utc_now(),\n199\t        None,\n200\t        body,\n201\t        &delta,\n202\t    );\n203\t    fleet::validate_handoff(&handoff)\n204\t        .map_err(|e| anyhow::anyhow!(\"refusing to write malformed handoff: {e}\"))?;\n205\t    fs::write(&handoff_path, &handoff)\n206\t        .with_context(|| format!(\"write {}\", handoff_path.display()))?;\n207\t\n208\t    println!(\n209\t        \"=== fleet: {} handoff governed (session {session:02}) ===\",\n210\t        role.name\n211\t    );\n212\t    println!(\"  handoff:    {handoff_rel}\");\n213\t    println!(\"  source-sha: {source_sha}\");\n214\t    println!(\n215\t        \"  delta:      {}\",\n216\t        delta.lines().next().unwrap_or(\"\").trim_start_matches(\"- \")\n217\t    );\n218\t    println!(\"  validated:  OK (frontmatter + non-empty body + ## Handoff Delta)\");\n219\t    Ok(())\n220\t}\n221\t\n222\t/// The value following `flag` in `args`, if present.\n223\tfn flag_value(args: &[String], flag: &str) -> Option<String> {\n224\t    let i = args.iter().position(|a| a == flag)?;\n225\t    args.get(i + 1).cloned()\n226\t}\n227\t\n228\t/// Read a role's findings from a file, or from stdin when the path is `-`.\n229\tfn read_findings(from: &str) -> Result<String> {\n230\t    if from == \"-\" {\n231\t        let mut buf = String::new();\n232\t        io::stdin()\n233\t            .lock()\n234\t            .read_to_string(&mut buf)\n235\t            .context(\"failed to read findings from stdin\")?;\n236\t        Ok(buf)\n237\t    } else {\n238\t        fs::read_to_string(from).with_context(|| format!(\"failed to read findings file {from:?}\"))\n239\t    }\n240\t}\n241\t\n242\t/// The CURRENT session number for the handoff path: the active `session-NN-<slug>` branch (names the\n243\t/// session in flight even before closeout flips `.ai/SESSION`), else `.ai/SESSION`.\n244\tfn current_session(root: &Path) -> Option<u32> {\n245\t    let branch = current_branch(root);\n246\t    if let Some(rest) = branch.strip_prefix(\"session-\") {\n247\t        let digits: String = rest.chars().take_while(|c| c.is_ascii_digit()).collect();\n248\t        if let Ok(n) = digits.parse::<u32>() {\n249\t            return Some(n);\n250\t        }\n251\t    }\n252\t    fs::read_to_string(root.join(\".ai/SESSION\"))\n253\t        .ok()?\n254\t        .trim()\n255\t        .parse()\n256\t        .ok()\n257\t}\n258\t\n259\t/// A UTC ISO-8601 timestamp for the handoff's `captured` field. Shells out to `date` (no chrono dep).\n260\tfn utc_now() -> String {\n261\t    Command::new(\"date\")\n262\t        .args([\"-u\", \"+%Y-%m-%dT%H:%M:%SZ\"])\n263\t        .output()\n264\t        .ok()\n265\t        .filter(|o| o.status.success())\n266\t        .and_then(|o| String::from_utf8(o.stdout).ok())\n267\t        .map(|s| s.trim().to_string())\n268\t        .filter(|s| !s.is_empty())\n269\t        .unwrap_or_else(|| \"unknown\".to_string())\n270\t}\n271\t\n272\t/// `vajra next --check-options NN` — the Analyst's OPTIONS gate (S62 / J2): does\n273\t/// `sessions/session-NN-summary.md` record exactly 3 ranked next candidates? Exit 1 if it records\n274\t/// a wrong count (BLOCK); pass on exactly 3 or a wholly absent section (WARN). Mirrors `--validate`.\n275\tfn run_check_options(nn: Option<&String>) -> Result<()> {\n276\t    let nn = nn.context(\"usage: vajra next --check-options <NN>\")?;\n277\t    let session: u32 = nn\n278\t        .trim()\n279\t        .parse()\n280\t        .with_context(|| format!(\"session number must be an integer (got {nn:?})\"))?;\n281\t    let root = repo_root()?;\n282\t\n283\t    let verdict = analyst::options_gate(&root, session);\n284\t    println!(\"=== analyst: ranked options for session {session:02} ===\");\n285\t    println!(\n286\t        \"summary: {}\",\n287\t        verdict.summary_path.as_deref().unwrap_or(\"(none)\")\n288\t    );\n289\t    if verdict.blocked() {\n290\t        println!(\"verdict: NOT READY\");\n291\t        for r in &verdict.reasons {\n292\t            println!(\"  ✗ {r}\");\n293\t        }\n294\t    } else {\n295\t        println!(\"verdict: READY\");\n296\t    }\n297\t    for w in &verdict.warnings {\n298\t        println!(\"  ⚠ {w}\");\n299\t    }\n300\t    if verdict.blocked() {\n301\t        std::process::exit(1);\n302\t    }\n303\t    Ok(())\n304\t}\n305\t\n306\t/// `vajra next --plan NN` — the Planner's SURFACE step (S64): print the acceptance criteria of\n307\t/// session NN's prompt as the checklist to plan against (the plan derives from the contract, not\n308\t/// thin air). Read-only; the binary surfaces, it does not author.\n309\tfn run_plan(nn: Option<&String>) -> Result<()> {\n310\t    let session = parse_session(nn, \"--plan\")?;\n311\t    let root = repo_root()?;\n312\t    let verdict = planner::plan_gate(&root, session);\n313\t    print!(\"{}\", planner::format_plan_checklist(&verdict));\n314\t    Ok(())\n315\t}\n316\t\n317\t/// `vajra next --check-plan NN` — the Planner's GATE (S64): does session NN's `## Plan` COVER every\n318\t/// acceptance criterion? Exit 1 on a placeholder/uncovered plan (BLOCK); pass on a covering plan or\n319\t/// a wholly absent one (WARN — legacy compat). Mirrors `--check-options`.\n320\tfn run_check_plan(nn: Option<&String>) -> Result<()> {\n321\t    let session = parse_session(nn, \"--check-plan\")?;\n322\t    let root = repo_root()?;\n323\t\n324\t    let verdict = planner::plan_gate(&root, session);\n325\t    println!(\"=== planner: plan for session {session:02} ===\");\n326\t    println!(\n327\t        \"prompt: {}\",\n328\t        verdict.prompt_path.as_deref().unwrap_or(\"(none)\")\n329\t    );\n330\t    if verdict.blocked() {\n331\t        println!(\"verdict: NOT READY\");\n332\t        for r in &verdict.reasons {\n333\t            println!(\"  ✗ {r}\");\n334\t        }\n335\t    } else {\n336\t        println!(\"verdict: READY\");\n337\t    }\n338\t    for w in &verdict.warnings {\n339\t        println!(\"  ⚠ {w}\");\n340\t    }\n341\t    if verdict.blocked() {\n342\t        std::process::exit(1);\n343\t    }\n344\t    Ok(())\n345\t}\n346\t\n347\t/// `vajra next --design NN` — the Architect's SURFACE step (S67): print the locked design spine\n348\t/// (`docs/adr/` + `docs/decisions/`) as the checklist session NN's `## Design` rationale must cite\n349\t/// from, with the prompt's current citations marked. Read-only; the binary surfaces, it does not\n350\t/// author a design.\n351\tfn run_design(nn: Option<&String>) -> Result<()> {\n352\t    let session = parse_session(nn, \"--design\")?;\n353\t    let root = repo_root()?;\n354\t    let verdict = architect::design_gate(&root, session);\n355\t    print!(\"{}\", architect::format_design_checklist(&verdict));\n356\t    Ok(())\n357\t}\n358\t\n359\t/// `vajra next --check-design NN` — the Architect's GATE (S67): a design-significant prompt\n360\t/// (recorded `design-significant: yes`) must carry a substantive, spine-citing `## Design`\n361\t/// rationale. Exit 1 on a missing/placeholder rationale (BLOCK); pass on a substantive one or a\n362\t/// non-significant prompt (WARN at most — legacy compat). Mirrors `--check-plan`.\n363\tfn run_check_design(nn: Option<&String>) -> Result<()> {\n364\t    let session = parse_session(nn, \"--check-design\")?;\n365\t    let root = repo_root()?;\n366\t\n367\t    let verdict = architect::design_gate(&root, session);\n368\t    println!(\"=== architect: design for session {session:02} ===\");\n369\t    println!(\n370\t        \"prompt: {}\",\n371\t        verdict.prompt_path.as_deref().unwrap_or(\"(none)\")\n372\t    );\n373\t    if verdict.blocked() {\n374\t        println!(\"verdict: NOT READY\");\n375\t        for r in &verdict.reasons {\n376\t            println!(\"  ✗ {r}\");\n377\t        }\n378\t    } else {\n379\t        println!(\"verdict: READY\");\n380\t    }\n381\t    for w in &verdict.warnings {\n382\t        println!(\"  ⚠ {w}\");\n383\t    }\n384\t    if verdict.blocked() {\n385\t        std::process::exit(1);\n386\t    }\n387\t    Ok(())\n388\t}\n389\t\n390\t/// `vajra next --exec NN` — the Coder's SURFACE step (S68): print session NN's plan steps as the\n391\t/// execution checklist with each step's recorded state (done `<sha>` / unrecorded). Read-only;\n392\t/// the binary surfaces the trace, it never codes.\n393\tfn run_exec(nn: Option<&String>) -> Result<()> {\n394\t    let session = parse_session(nn, \"--exec\")?;\n395\t    let root = repo_root()?;\n396\t    let verdict = coder::exec_gate(&root, session);\n397\t    print!(\"{}\", coder::format_exec_checklist(&verdict));\n398\t    Ok(())\n399\t}\n400\t\n401\t/// `vajra next --check-exec NN` — the Coder's GATE (S68): does session NN record a `done: <sha>`\n402\t/// naming a commit that EXISTS for every numbered plan step? Exit 1 on an unrecorded/fake trace\n403\t/// (BLOCK); pass on a fully recorded one; a legacy prompt (no `## Execution`) WARNS at most.\n404\t/// Mirrors `--check-design`.\n405\tfn run_check_exec(nn: Option<&String>) -> Result<()> {\n406\t    let session = parse_session(nn, \"--check-exec\")?;\n407\t    let root = repo_root()?;\n408\t\n409\t    let verdict = coder::exec_gate(&root, session);\n410\t    println!(\"=== coder: execution for session {session:02} ===\");\n411\t    println!(\n412\t        \"prompt: {}\",\n413\t        verdict.prompt_path.as_deref().unwrap_or(\"(none)\")\n414\t    );\n415\t    if verdict.blocked() {\n416\t        println!(\"verdict: NOT READY\");\n417\t        for r in &verdict.reasons {\n418\t            println!(\"  ✗ {r}\");\n419\t        }\n420\t    } else {\n421\t        println!(\"verdict: READY\");\n422\t    }\n423\t    for w in &verdict.warnings {\n424\t        println!(\"  ⚠ {w}\");\n425\t    }\n426\t    if verdict.blocked() {\n427\t        std::process::exit(1);\n428\t    }\n429\t    Ok(())\n430\t}\n431\t\n432\t/// `vajra next --qa NN` — the QA station's SURFACE step (S69): print session NN's recorded\n433\t/// verify contract (expected script, recorded `.ai/verify/` runs, latest) read-only — nothing\n434\t/// executes here. The contract derives from `CONSTRAINTS.yaml#verify`, not thin air.\n435\tfn run_qa(nn: Option<&String>) -> Result<()> {\n436\t    let session = parse_session(nn, \"--qa\")?;\n437\t    let root = repo_root()?;\n438\t    print!(\n439\t        \"{}\",\n440\t        qa::format_qa_contract(&qa::gather_contract(&root, session))\n441\t    );\n442\t    Ok(())\n443\t}\n444\t\n445\t/// `vajra next --check-qa NN` — the QA station's GATE (S69): RE-RUN session NN's verify script\n446\t/// LIVE and exit 1 on non-zero (BLOCK) — a previously recorded green is never accepted as proof\n447\t/// (no stale-green). A missing script (NO-CODE GT / legacy) WARNS at most, the dodge named.\n448\t/// Mirrors `--check-exec`. Honest cost: the live run executes cargo build/test — slow, on purpose.\n449\tfn run_check_qa(nn: Option<&String>) -> Result<()> {\n450\t    let session = parse_session(nn, \"--check-qa\")?;\n451\t    let root = repo_root()?;\n452\t\n453\t    println!(\"=== qa: verify for session {session:02} ===\");\n454\t    let verdict = qa::qa_gate(&root, session);\n455\t    println!(\"script: {}\", verdict.contract.script);\n456\t    if verdict.blocked() {\n457\t        println!(\"verdict: NOT READY\");\n458\t        for r in &verdict.reasons {\n459\t            println!(\"  ✗ {r}\");\n460\t        }\n461\t    } else {\n462\t        println!(\"verdict: READY\");\n463\t    }\n464\t    for w in &verdict.warnings {\n465\t        println!(\"  ⚠ {w}\");\n466\t    }\n467\t    if verdict.blocked() {\n468\t        std::process::exit(1);\n469\t    }\n470\t    Ok(())\n471\t}\n472\t\n473\t/// `vajra next --demo NN` — the Demo-er station's SURFACE step (S71): print session NN's\n474\t/// recorded sprint-demo contract (expected script, required elements found/missing in the script\n475\t/// text) read-only — nothing executes here. The contract derives from `CONSTRAINTS.yaml#demo`,\n476\t/// not thin air.\n477\tfn run_demo(nn: Option<&String>) -> Result<()> {\n478\t    let session = parse_session(nn, \"--demo\")?;\n479\t    let root = repo_root()?;\n480\t    print!(\n481\t        \"{}\",\n482\t        demoer::format_demo_contract(&demoer::gather_contract(&root, session))\n483\t    );\n484\t    Ok(())\n485\t}\n486\t\n487\t/// `vajra next --check-demo NN` — the Demo-er station's GATE (S71): RE-RUN session NN's demo\n488\t/// script LIVE and exit 1 on a non-zero exit OR on required elements missing from the live\n489\t/// output (BLOCK) — a recorded green is never accepted, and a hollow exit-0 demo fails the\n490\t/// element scan. A missing script (NO-CODE GT / legacy) WARNS at most, the dodge named.\n491\t/// Mirrors `--check-qa`. Honest cost: the live run executes the demo — real seconds.\n492\tfn run_check_demo(nn: Option<&String>) -> Result<()> {\n493\t    let session = parse_session(nn, \"--check-demo\")?;\n494\t    let root = repo_root()?;\n495\t\n496\t    println!(\"=== demoer: sprint demo for session {session:02} ===\");\n497\t    let verdict = demoer::demo_gate(&root, session);\n498\t    println!(\"script: {}\", verdict.contract.script);\n499\t    if verdict.blocked() {\n500\t        println!(\"verdict: NOT READY\");\n501\t        for r in &verdict.reasons {\n502\t            println!(\"  ✗ {r}\");\n503\t        }\n504\t    } else {\n505\t        println!(\"verdict: READY\");\n506\t    }\n507\t    for w in &verdict.warnings {\n508\t        println!(\"  ⚠ {w}\");\n509\t    }\n510\t    if verdict.blocked() {\n511\t        std::process::exit(1);\n512\t    }\n513\t    Ok(())\n514\t}\n515\t\n516\t/// `vajra next --release NN` — the Releaser station's SURFACE step (S72): print session NN's\n517\t/// ship state (branch merged into main or not, local main vs origin/main, unpruned merged\n518\t/// `session-*` locals) re-derived from LOCAL git refs, read-only — nothing is fetched, pushed,\n519\t/// merged, or deleted here or anywhere in the station.\n520\tfn run_release(nn: Option<&String>) -> Result<()> {\n521\t    let session = parse_session(nn, \"--release\")?;\n522\t    let root = repo_root()?;\n523\t    print!(\n524\t        \"{}\",\n525\t        releaser::format_release_report(&releaser::release_gate(&root, session))\n526\t    );\n527\t    Ok(())\n528\t}\n529\t\n530\t/// `vajra next --check-release NN` — the Releaser station's GATE (S72): exit 1 when session\n531\t/// NN's ship hygiene is unfinished — its branch is not an ancestor of main, local main is\n532\t/// behind/diverged from the last-fetched origin/main, or merged `session-*` branches (other\n533\t/// than the current one) are unpruned. Derived live from git; a repo where the state cannot\n534\t/// be derived FAILS, never silently passes. Mirrors `--check-demo`.\n535\tfn run_check_release(nn: Option<&String>) -> Result<()> {\n536\t    let session = parse_session(nn, \"--check-release\")?;\n537\t    let root = repo_root()?;\n538\t\n539\t    println!(\"=== releaser: ship for session {session:02} ===\");\n540\t    let verdict = releaser::release_gate(&root, session);\n541\t    if let Some(state) = &verdict.state {\n542\t        println!(\"main: {} · branch: {}\", state.main, {\n543\t            match &state.branch {\n544\t                releaser::BranchShip::Merged(refs) => format!(\"{} (merged)\", refs.join(\", \")),\n545\t                releaser::BranchShip::Unmerged(refs) => {\n546\t                    format!(\"{} (NOT merged)\", refs.join(\", \"))\n547\t                }\n548\t                releaser::BranchShip::NoBranch => \"not found (pruned or never created)\".into(),\n549\t            }\n550\t        });\n551\t    }\n552\t    if verdict.blocked() {\n553\t        println!(\"verdict: NOT READY\");\n554\t        for r in &verdict.reasons {\n555\t            println!(\"  ✗ {r}\");\n556\t        }\n557\t    } else {\n558\t        println!(\"verdict: READY\");\n559\t    }\n560\t    for w in &verdict.warnings {\n561\t        println!(\"  ⚠ {w}\");\n562\t    }\n563\t    if verdict.blocked() {\n564\t        std::process::exit(1);\n565\t    }\n566\t    Ok(())\n567\t}\n568\t\n569\t/// Parse a `<NN>` session-number argument shared by the Planner subcommands.\n570\tfn parse_session(nn: Option<&String>, flag: &str) -> Result<u32> {\n571\t    let nn = nn.with_context(|| format!(\"usage: vajra next {flag} <NN>\"))?;\n572\t    nn.trim()\n573\t        .parse()\n574\t        .with_context(|| format!(\"session number must be an integer (got {nn:?})\"))\n575\t}\n576\t\n577\t/// `vajra next --scaffold NN <slug>` — the Analyst's GENERATE step: write a well-formed prompt\n578\t/// (`prompts/NN-task-<slug>.md`) from the Borrow-Engine template, ready to fill and approve.\n579\tfn run_scaffold(nn: Option<&String>, slug: Option<&String>) -> Result<()> {\n580\t    let (nn, slug) = match (nn, slug) {\n581\t        (Some(nn), Some(slug)) => (nn, slug),\n582\t        _ => bail!(\"usage: vajra next --scaffold <NN> <slug>   (e.g. --scaffold 56 planner-stage)\"),\n583\t    };\n584\t    let session: u32 = nn\n585\t        .trim()\n586\t        .parse()\n587\t        .with_context(|| format!(\"session number must be an integer (got {nn:?})\"))?;\n588\t\n589\t    let root = repo_root()?;\n590\t\n591\t    // S62 / J1: surface the real intake inputs FIRST — the prior session + ROADMAP next-builds the\n592\t    // author must fold into the Goal, so the job comes from context, not the bare slug. S112 adds\n593\t    // the third input: this session's governed fleet handoffs (findings the next job should fold in).\n594\t    let current = current_session(&root);\n595\t    print!(\n596\t        \"{}\",\n597\t        analyst::format_intake(&analyst::gather_intake(&root, current))\n598\t    );\n599\t    println!();\n600\t\n601\t    // S61 / J3: GENERATE writes the prompt AND updates the `.ai/TASK.md` pointer (the spine).\n602\t    // Previously scaffold only `println!`d advice — the pointer was never moved.\n603\t    let rel = scaffold_and_point(&root, session, slug)?;\n604\t    println!(\"scaffolded {rel} (DRAFT)\");\n605\t    println!(\"  .ai/TASK.md pointer -> {rel}\");\n606\t    println!(\"  fill Goal/Deliverables/Acceptance/Guardrails/Delta, then flip Status -> APPROVED.\");\n607\t    println!(\n608\t        \"  the advance gate blocks `vajra next --advance` into session {session:02} until then.\"\n609\t    );\n610\t    Ok(())\n611\t}\n612\t\n613\t/// The Analyst's GENERATE step, factored pure (explicit `root`) so a test can drive it without\n614\t/// `current_dir`. Writes `prompts/NN-task-<slug>.md`, then repoints `.ai/TASK.md` at it — closing\n615\t/// the S54 J3 gap (\"write the prompt + update TASK.md\"). Reuses `update_prompt_pointer` (the same\n616\t/// helper `--advance` uses — one implementation, no second store, no drift). The pointer update is\n617\t/// a no-op if TASK.md lacks a `Read prompt:` line, so it never clobbers unrelated prose.\n618\tfn scaffold_and_point(root: &Path, session: u32, slug: &str) -> Result<String> {\n619\t    let path = analyst::scaffold_prompt(root, session, slug).map_err(|e| anyhow::anyhow!(e))?;\n620\t    let rel = path\n621\t        .strip_prefix(root)\n622\t        .unwrap_or(&path)\n623\t        .to_string_lossy()\n624\t        .into_owned();\n625\t    update_prompt_pointer(root, \".ai/TASK.md\", &rel)?;\n626\t    Ok(rel)\n627\t}\n628\t\n629\t/// `vajra next --validate NN` — the Analyst's report: is prompts/NN-*.md well-formed?\n630\tfn run_validate(nn: Option<&String>) -> Result<()> {\n631\t    let nn = nn.context(\"usage: vajra next --validate <NN>\")?;\n632\t    let session: u32 = nn\n633\t        .trim()\n634\t        .parse()\n635\t        .with_context(|| format!(\"session number must be an integer (got {nn:?})\"))?;\n636\t\n637\t    let cwd = env::current_dir().context(\"failed to read current directory\")?;\n638\t    let root =\n639\t        find_repo_root(&cwd).context(\"could not find a Vajra repo (.ai directory missing)\")?;\n640\t\n641\t    let verdict = analyst::gate(&root, session);\n642\t    println!(\"=== analyst: prompt for session {session:02} ===\");\n643\t    println!(\n644\t        \"prompt: {}\",\n645\t        verdict.prompt_path.as_deref().unwrap_or(\"(none)\")\n646\t    );\n647\t    if verdict.blocked() {\n648\t        println!(\"verdict: NOT READY\");\n649\t        for r in &verdict.reasons {\n650\t            println!(\"  ✗ {r}\");\n651\t        }\n652\t    } else {\n653\t        println!(\"verdict: READY\");\n654\t    }\n655\t    for w in &verdict.warnings {\n656\t        println!(\"  ⚠ {w}\");\n657\t    }\n658\t    // S112: if the fleet produced governed findings for THIS session, the Analyst shows them at its\n659\t    // own gate — the WHAT is read next to the research that informs it, not in a separate file\n660\t    // nobody opens. Advisory only: it never blocks, and prints nothing when there is no handoff.\n661\t    print!(\n662\t        \"{}\",\n663\t        fleet::format_handoff_brief(\n664\t            &fleet::read_handoffs(&root, session),\n665\t            analyst::FLEET_HEAD_LINES\n666\t        )\n667\t    );\n668\t    if verdict.blocked() {\n669\t        std::process::exit(1);\n670\t    }\n671\t    Ok(())\n672\t}\n673\t\n674\t/// Whether the founder pre-authorized commits for THIS session at launch (S99).\n675\t///\n676\t/// The S97 Ladder-Rung-1 blocker (b): `commit.autonomous: false` + `require_user_approval: true`\n677\t/// are satisfiable only by a conversational approval token, and a headless `-p` run has no channel\n678\t/// to receive one — so an unattended session can never commit, and the Coder station can never\n679\t/// record a sha. The token has an out-of-band form already (`VAJRA_ALLOW_COMMIT=NN`, the S93\n680\t/// un-forgeable env marker the L3 guard enforces); what was missing is that nothing TELLS the\n681\t/// agent it exists. This classification mirrors `scripts/hook-commit-guard.sh` exactly so the\n682\t/// packet can never say \"pre-granted\" where the guard would block.\n683\t///\n684\t/// **Honest bound (disclosed):** this reads `vajra next`'s own process environment, which the\n685\t/// agent controls — so the line is ADVISORY, never a permission. The un-forgeable teeth stay with\n686\t/// the L3 guard, which reads its OWN launch env before the command runs; an agent that inlines\n687\t/// the marker gets an explicit BLOCK there regardless of what this line said.\n688\t#[derive(Debug, Clone, PartialEq, Eq)]\n689\tenum CommitAuth {\n690\t    /// Marker present and valid for this session — the guard would ALLOW.\n691\t    PreGranted(String),\n692\t    /// Marker present but scoped to a different session — the guard would BLOCK.\n693\t    Mismatch { marker: String, session: String },\n694\t    /// No marker — a human approval token in chat is the only route.\n695\t    TokenRequired,\n696\t}\n697\t\n698\t/// Classify the launch environment against the branch-derived session, exactly as the L3 guard\n699\t/// does: session digits come from a `session-NN-*` branch; off such a branch the guard accepts any\n700\t/// non-empty marker, so the packet reports the same.\n701\tfn commit_authorization(branch: &str, marker: Option<&str>) -> CommitAuth {\n702\t    let session = branch\n703\t        .strip_prefix(\"session-\")\n704\t        .and_then(|rest| rest.split_once('-'))\n705\t        .map(|(digits, _)| digits)\n706\t        .filter(|d| !d.is_empty() && d.chars().all(|c| c.is_ascii_digit()));\n707\t    match (marker.filter(|m| !m.is_empty()), session) {\n708\t        (None, _) => CommitAuth::TokenRequired,\n709\t        (Some(m), None) => CommitAuth::PreGranted(m.to_string()),\n710\t        (Some(m), Some(s)) if m == s => CommitAuth::PreGranted(m.to_string()),\n711\t        (Some(m), Some(s)) => CommitAuth::Mismatch {\n712\t            marker: m.to_string(),\n713\t            session: s.to_string(),\n714\t        },\n715\t    }\n716\t}\n717\t\n718\tfn render_commit_auth(auth: CommitAuth) -> String {\n719\t    match auth {\n720\t        CommitAuth::PreGranted(m) => format!(\n721\t            \"commit approval: PRE-GRANTED — VAJRA_ALLOW_COMMIT={m} is set in this launch \\\n722\t             environment.\\n  That marker IS the founder's approval token for this session \\\n723\t             (S93); commits may proceed\\n  without a chat token. Advisory line — the L3 \\\n724\t             guard remains the enforcing check.\"\n725\t        ),\n726\t        CommitAuth::Mismatch { marker, session } => format!(\n727\t            \"commit approval: NOT VALID HERE — VAJRA_ALLOW_COMMIT={marker} is scoped to session \\\n728\t             {marker},\\n  but this branch is session {session}. The guard will BLOCK. Relaunch \\\n729\t             with VAJRA_ALLOW_COMMIT={session}.\"\n730\t        ),\n731\t        CommitAuth::TokenRequired => String::from(\n732\t            \"commit approval: REQUIRED — no VAJRA_ALLOW_COMMIT in this launch environment.\\n  \\\n733\t             A human must give an approval token in chat before any commit. For an UNATTENDED \\\n734\t             run,\\n  the founder pre-authorizes at launch: `VAJRA_ALLOW_COMMIT=NN vajra claude`.\",\n735\t        ),\n736\t    }\n737\t}\n738\t\n739\tfn run_dump() -> Result<()> {\n740\t    let cwd = env::current_dir().context(\"failed to read current directory\")?;\n741\t    let root =\n742\t        find_repo_root(&cwd).context(\"could not find a Vajra repo (.ai directory missing)\")?;\n743\t    let session =\n744\t        fs::read_to_string(root.join(\".ai/SESSION\")).context(\"failed to read .ai/SESSION\")?;\n745\t    let task = fs::read_to_string(root.join(\".ai/TASK.md\")).ok();\n746\t    let boot = fs::read_to_string(root.join(\".ai/SESSION-BOOT.md\")).ok();\n747\t    let prompt = task\n748\t        .as_deref()\n749\t        .and_then(extract_prompt_path)\n750\t        .or_else(|| boot.as_deref().and_then(extract_prompt_path));\n751\t\n752\t    println!(\"=== vajra next ===\");\n753\t    println!(\"repo: {}\", root.display());\n754\t    println!(\"branch: {}\", current_branch(&root));\n755\t    println!(\"session: {}\", session.trim());\n756\t    println!(\n757\t        \"prompt: {}\",\n758\t        prompt.as_deref().unwrap_or(\"(no prompt pointer found)\")\n759\t    );\n760\t    // S99: an unattended run has no chat channel to utter an approval token, so the packet must\n761\t    // say whether the founder pre-authorized commits at launch (the S97 Rung-1 blocker (b)).\n762\t    println!(\n763\t        \"{}\",\n764\t        render_commit_auth(commit_authorization(\n765\t            &current_branch(&root),\n766\t            env::var(\"VAJRA_ALLOW_COMMIT\").ok().as_deref(),\n767\t        ))\n768\t    );\n769\t    println!();\n770\t\n771\t    // S104 team voice: the pipeline team's progress on THIS session, in plain English — the SAME\n772\t    // role narration `vajra next --stations` uses (one source in `stations`, no second copy). A\n773\t    // non-numeric `.ai/SESSION` just skips the roster rather than breaking the packet.\n774\t    if let Ok(n) = session.trim().parse::<u32>() {\n775\t        let report = stations::station_report(&root, n);\n776\t        println!(\"----- pipeline team (session {n:02}) -----\");\n777\t        print!(\"{}\", stations::format_team_roster(&report));\n778\t        println!(\n779\t            \"  {} of {} roles have finished their part\",\n780\t            report.passed(),\n781\t            stations::STATION_COUNT\n782\t        );\n783\t        println!();\n784\t    }\n785\t\n786\t    // S112 — the fleet's findings reach the agent that needs them. Before this, a governed handoff\n787\t    // was written into `.ai/handoffs/` and read by nobody: the packet (the context an agent boots\n788\t    // on) never mentioned it. Now the CURRENT session's handoffs ride the packet, findings inline.\n789\t    // Silent when there are none — a session with no fleet work sees the packet it always saw.\n790\t    if let Some(n) = current_session(&root) {\n791\t        let brief =\n792\t            fleet::format_handoff_brief(&fleet::read_handoffs(&root, n), analyst::FLEET_HEAD_LINES);\n793\t        if !brief.is_empty() {\n794\t            println!(\"----- fleet handoffs (session {n:02}) -----\");\n795\t            print!(\"{brief}\");\n796\t            println!();\n797\t        }\n798\t    }\n799\t\n800\t    for relative in PACKET_FILES {\n801\t        print_file(&root, relative)?;\n802\t    }\n803\t\n804\t    if root.join(\"VISION.md\").is_file() {\n805\t        print_file(&root, \"VISION.md\")?;\n806\t    }\n807\t\n808\t    if let Some(relative) = prompt {\n809\t        let prompt_path = root.join(&relative);\n810\t        if prompt_path.is_file() {\n811\t            print_file(&root, &relative)?;\n812\t        } else {\n813\t            eprintln!(\"[vajra] warning: prompt file not found: {relative}\");\n814\t        }\n815\t    }\n816\t\n817\t    Ok(())\n818\t}\n819\t\n820\tfn run_advance() -> Result<()> {\n821\t    let cwd = env::current_dir().context(\"failed to read current directory\")?;\n822\t    let root =\n823\t        find_repo_root(&cwd).context(\"could not find a Vajra repo (.ai directory missing)\")?;\n824\t\n825\t    let branch = current_branch(&root);\n826\t    if branch == \"main\" || branch == \"master\" {\n827\t        bail!(\"refusing to advance on {branch} — switch to a session branch first\");\n828\t    }\n829\t\n830\t    let session_content =\n831\t        fs::read_to_string(root.join(\".ai/SESSION\")).context(\"failed to read .ai/SESSION\")?;\n832\t    let current: u32 = session_content\n833\t        .trim()\n834\t        .parse()\n835\t        .context(\".ai/SESSION is not a valid integer\")?;\n836\t    let next = current + 1;\n837\t\n838\t    let maturity = read_maturity(&root.join(\".ai/CONSTRAINTS.yaml\"));\n839\t\n840\t    eprintln!(\"vajra next --advance ({maturity} {})\", maturity.label());\n841\t    eprintln!(\"  current session: {current:02}\");\n842\t    eprintln!(\"  next session:    {next:02}\");\n843\t    eprintln!(\"  branch:          {branch}\");\n844\t    eprintln!();\n845\t\n846\t    // Analyst gate (S54): the pipeline's first handoff must be governed — you cannot advance\n847\t    // INTO session N+1 unless its prompt is present, well-formed, and APPROVED (not DRAFT).\n848\t    // Fail-closed at L2/L3; advise at L1; `VAJRA_SKIP_ANALYST_GATE=1` is the documented override.\n849\t    let verdict = analyst::gate(&root, next);\n850\t    for w in &verdict.warnings {\n851\t        eprintln!(\"  ⚠ {w}\");\n852\t    }\n853\t    if verdict.blocked() {\n854\t        eprintln!(\"[vajra analyst] the prompt for session {next:02} is NOT ready:\");\n855\t        for r in &verdict.reasons {\n856\t            eprintln!(\"    ✗ {r}\");\n857\t        }\n858\t        if maturity == MaturityLevel::L1 {\n859\t            eprintln!(\"  (L1 advise — advancing anyway.)\");\n860\t        } else if env::var(\"VAJRA_SKIP_ANALYST_GATE\").is_ok() {\n861\t            eprintln!(\"  (VAJRA_SKIP_ANALYST_GATE set — advancing anyway.)\");\n862\t        } else {\n863\t            bail!(\n864\t                \"refusing to advance: session {next:02} has no approved, well-formed prompt \\\n865\t                 (Analyst gate). Run `vajra next --scaffold {next:02} <slug>`, fill + approve it, \\\n866\t                 or set VAJRA_SKIP_ANALYST_GATE=1 to override.\"\n867\t            );\n868\t        }\n869\t    }\n870\t\n871\t    // Options gate (S62 / J2): closing `current` requires its summary to record EXACTLY 3 ranked\n872\t    // next candidates (end_of_session.must_present_n_options). A wrong count BLOCKS — a non-author\n873\t    // cannot close a session on 2 or 4 options; a wholly absent section only WARNS (legacy compat).\n874\t    // Same fail-closed-at-L2/L3, advise-at-L1, VAJRA_SKIP_ANALYST_GATE override as the prompt gate.\n875\t    let opts = analyst::options_gate(&root, current);\n876\t    for w in &opts.warnings {\n877\t        eprintln!(\"  ⚠ {w}\");\n878\t    }\n879\t    if opts.blocked() {\n880\t        eprintln!(\"[vajra analyst] session {current:02} cannot close — its options are not ready:\");\n881\t        for r in &opts.reasons {\n882\t            eprintln!(\"    ✗ {r}\");\n883\t        }\n884\t        if maturity == MaturityLevel::L1 {\n885\t            eprintln!(\"  (L1 advise — advancing anyway.)\");\n886\t        } else if env::var(\"VAJRA_SKIP_ANALYST_GATE\").is_ok() {\n887\t            eprintln!(\"  (VAJRA_SKIP_ANALYST_GATE set — advancing anyway.)\");\n888\t        } else {\n889\t            bail!(\n890\t                \"refusing to advance: session {current:02} does not record exactly 3 ranked next \\\n891\t                 candidates (Options gate). Fix its summary, or set VAJRA_SKIP_ANALYST_GATE=1.\"\n892\t            );\n893\t        }\n894\t    }\n895\t\n896\t    // Coder gate (S68): the pipeline's CODE/execution bookend. Like the Options gate it binds on\n897\t    // the session being CLOSED — execution happened during `current`, so closing it requires each\n898\t    // numbered plan step to record a `done: <sha>` naming a commit that EXISTS (`git cat-file -e`\n899\t    // — the S67 existence lesson, git-shaped). An unrecorded/fake trace BLOCKS at L2/L3; a legacy\n900\t    // prompt (no `## Execution`) WARNS at most. `VAJRA_SKIP_CODER_GATE=1` is the documented\n901\t    // override (distinct from the other stages', so each stage overrides alone).\n902\t    let exec_verdict = coder::exec_gate(&root, current);\n903\t    for w in &exec_verdict.warnings {\n904\t        eprintln!(\"  ⚠ {w}\");\n905\t    }\n906\t    if exec_verdict.blocked() {\n907\t        eprintln!(\n908\t            \"[vajra coder] session {current:02} cannot close — its execution trace is not recorded:\"\n909\t        );\n910\t        for r in &exec_verdict.reasons {\n911\t            eprintln!(\"    ✗ {r}\");\n912\t        }\n913\t        if maturity == MaturityLevel::L1 {\n914\t            eprintln!(\"  (L1 advise — advancing anyway.)\");\n915\t        } else if env::var(\"VAJRA_SKIP_CODER_GATE\").is_ok() {\n916\t            eprintln!(\"  (VAJRA_SKIP_CODER_GATE set — advancing anyway.)\");\n917\t        } else {\n918\t            bail!(\n919\t                \"refusing to advance: session {current:02}'s plan steps lack a recorded, existing \\\n920\t                 commit (Coder gate). Run `vajra next --exec {current:02}`, record \\\n921\t                 `step N — done: <sha>` per step in the prompt's `## Execution`, or set \\\n922\t                 VAJRA_SKIP_CODER_GATE=1 to override.\"\n923\t            );\n924\t        }\n925\t    }\n926\t\n927\t    // QA gate (S69): the pipeline's WORKS bookend. Like the Coder gate it binds on the session\n928\t    // being CLOSED — closing `current` requires its verify script to pass a LIVE re-run (a\n929\t    // recorded green is never trusted; no stale-green). Honest cost: the re-run executes the\n930\t    // session's verify (cargo build/test — slow, on purpose: live evidence). A missing script\n931\t    // (NO-CODE ground-truth / legacy) WARNS at most, the dodge named. `VAJRA_SKIP_QA_GATE=1`\n932\t    // is the documented override (distinct from the other stages', so each overrides alone).\n933\t    if env::var(\"VAJRA_SKIP_QA_GATE\").is_ok() {\n934\t        // The one gate where the override skips the CHECK itself, not just the block: a live\n935\t        // re-run is slow and side-effectful, and the author explicitly opted out.\n936\t        eprintln!(\"  ⚠ [vajra qa] VAJRA_SKIP_QA_GATE set — live verify re-run skipped.\");\n937\t    } else {\n938\t        eprintln!(\"  [vajra qa] re-running session {current:02}'s verify LIVE (slow, on purpose):\");\n939\t        let qa_verdict = qa::qa_gate(&root, current);\n940\t        for w in &qa_verdict.warnings {\n941\t            eprintln!(\"  ⚠ {w}\");\n942\t        }\n943\t        if qa_verdict.blocked() {\n944\t            eprintln!(\n945\t                \"[vajra qa] session {current:02} cannot close — its verify does not pass live:\"\n946\t            );\n947\t            for r in &qa_verdict.reasons {\n948\t                eprintln!(\"    ✗ {r}\");\n949\t            }\n950\t            if maturity == MaturityLevel::L1 {\n951\t                eprintln!(\"  (L1 advise — advancing anyway.)\");\n952\t            } else {\n953\t                bail!(\n954\t                    \"refusing to advance: session {current:02}'s verify script does not pass a \\\n955\t                     live re-run (QA gate). Run `vajra next --check-qa {current:02}`, fix the \\\n956\t                     verify until it is green live, or set VAJRA_SKIP_QA_GATE=1 to override.\"\n957\t                );\n958\t            }\n959\t        }\n960\t    }\n961\t\n962\t    // Demo-er gate (S71): the pipeline's SHOW bookend. Like the QA gate it binds on the session\n963\t    // being CLOSED — closing `current` requires its sprint demo to run green LIVE and to SHOW\n964\t    // every required element (header · cases · summary_table · before_after) in that live\n965\t    // output: \"seeing it, the user knows what this session delivered, and the before-and-after.\"\n966\t    // A hollow exit-0 demo fails the element scan; a recorded green is never trusted. A missing\n967\t    // script (NO-CODE ground-truth / legacy) WARNS at most, the dodge named.\n968\t    // `VAJRA_SKIP_DEMOER_GATE=1` is the documented override (distinct from the other stages',\n969\t    // so each overrides alone) — like QA's it skips the slow live run ITSELF, disclosed: an\n970\t    // opted-out close records no live demo evidence.\n971\t    if env::var(\"VAJRA_SKIP_DEMOER_GATE\").is_ok() {\n972\t        eprintln!(\"  ⚠ [vajra demoer] VAJRA_SKIP_DEMOER_GATE set — live demo re-run skipped.\");\n973\t    } else {\n974\t        eprintln!(\n975\t            \"  [vajra demoer] re-running session {current:02}'s demo LIVE (real seconds, on purpose):\"\n976\t        );\n977\t        let demo_verdict = demoer::demo_gate(&root, current);\n978\t        for w in &demo_verdict.warnings {\n979\t            eprintln!(\"  ⚠ {w}\");\n980\t        }\n981\t        if demo_verdict.blocked() {\n982\t            eprintln!(\n983\t                \"[vajra demoer] session {current:02} cannot close — its sprint demo does not \\\n984\t                 show live:\"\n985\t            );\n986\t            for r in &demo_verdict.reasons {\n987\t                eprintln!(\"    ✗ {r}\");\n988\t            }\n989\t            if maturity == MaturityLevel::L1 {\n990\t                eprintln!(\"  (L1 advise — advancing anyway.)\");\n991\t            } else {\n992\t                bail!(\n993\t                    \"refusing to advance: session {current:02}'s demo does not pass a live \\\n994\t                     re-run showing every required element (Demo-er gate). Run `vajra next \\\n995\t                     --check-demo {current:02}`, fix the demo until it shows green live, or set \\\n996\t                     VAJRA_SKIP_DEMOER_GATE=1 to override.\"\n997\t                );\n998\t            }\n999\t        }\n1000\t    }\n1001\t\n1002\t    // Releaser gate (S72): the pipeline's SHIP bookend — the last closing gate. Unlike the\n1003\t    // QA/Demo-er gates it binds on the PRIOR session (the newest session at-or-below `current`\n1004\t    // that left a branch or prompt, skipping the branch currently checked out): `current`'s own\n1005\t    // PR merges AFTER this close, so the freshest verifiable ship is the previous one. Its work\n1006\t    // must be merged into main (git ancestry), local main synced with the last-fetched\n1007\t    // origin/main, and merged session-* branches pruned — the S37 founder-flagged\n1008\t    // return-to-main step, enforced instead of remembered. Everything is re-derived from LOCAL\n1009\t    // git refs at check time (nothing recorded to forge; no network, no gh) and the gate never\n1010\t    // pushes, merges, or deletes — shipping stays a human act it waits for. A fresh repo (no\n1011\t    // prior evidence) WARNS at most, the dodge named. `VAJRA_SKIP_RELEASER_GATE=1` is the\n1012\t    // documented override (distinct — the check itself is cheap git reads, so unlike QA's it\n1013\t    // still runs and prints; the env only bypasses the block).\n1014\t    let ship = releaser::release_gate_for_close(&root, current);\n1015\t    for w in &ship.warnings {\n1016\t        eprintln!(\"  ⚠ {w}\");\n1017\t    }\n1018\t    if ship.blocked() {\n1019\t        let target = ship\n1020\t            .session\n1021\t            .map(|s| format!(\"{s:02}\"))\n1022\t            .unwrap_or_else(|| \"??\".into());\n1023\t        eprintln!(\n1024\t            \"[vajra releaser] session {target}'s ship hygiene is unfinished — the close waits:\"\n1025\t        );\n1026\t        for r in &ship.reasons {\n1027\t            eprintln!(\"    ✗ {r}\");\n1028\t        }\n1029\t        if maturity == MaturityLevel::L1 {\n1030\t            eprintln!(\"  (L1 advise — advancing anyway.)\");\n1031\t        } else if env::var(\"VAJRA_SKIP_RELEASER_GATE\").is_ok() {\n1032\t            eprintln!(\"  (VAJRA_SKIP_RELEASER_GATE set — advancing anyway.)\");\n1033\t        } else {\n1034\t            bail!(\n1035\t                \"refusing to advance: session {target}'s release is unfinished (Releaser gate). \\\n1036\t                 Run `vajra next --release {target}`, finish the ship (merge the PR / sync main \\\n1037\t                 / prune merged session-* branches), or set VAJRA_SKIP_RELEASER_GATE=1 to \\\n1038\t                 override.\"\n1039\t            );\n1040\t        }\n1041\t    }\n1042\t\n1043\t    // Architect gate (S67): the pipeline's DESIGN handoff, between the Analyst's WHAT and the\n1044\t    // Planner's HOW-plan. You cannot advance INTO session N+1 when its prompt records\n1045\t    // `design-significant: yes` but carries no substantive, spine-citing `## Design` rationale.\n1046\t    // Non-significant/legacy prompts WARN at most. Same fail-closed-at-L2/L3, advise-at-L1\n1047\t    // posture; `VAJRA_SKIP_ARCHITECT_GATE=1` is the documented override (distinct from the\n1048\t    // Analyst's and Planner's, so each stage overrides alone).\n1049\t    let design_verdict = architect::design_gate(&root, next);\n1050\t    for w in &design_verdict.warnings {\n1051\t        eprintln!(\"  ⚠ {w}\");\n1052\t    }\n1053\t    if design_verdict.blocked() {\n1054\t        eprintln!(\n1055\t            \"[vajra architect] session {next:02} is design-significant with no recorded design:\"\n1056\t        );\n1057\t        for r in &design_verdict.reasons {\n1058\t            eprintln!(\"    ✗ {r}\");\n1059\t        }\n1060\t        if maturity == MaturityLevel::L1 {\n1061\t            eprintln!(\"  (L1 advise — advancing anyway.)\");\n1062\t        } else if env::var(\"VAJRA_SKIP_ARCHITECT_GATE\").is_ok() {\n1063\t            eprintln!(\"  (VAJRA_SKIP_ARCHITECT_GATE set — advancing anyway.)\");\n1064\t        } else {\n1065\t            bail!(\n1066\t                \"refusing to advance: session {next:02} is design-significant but records no \\\n1067\t                 substantive `## Design` rationale (Architect gate). Run `vajra next --design \\\n1068\t                 {next:02}`, record the rationale citing the ADR/DECISION it rests on, or set \\\n1069\t                 VAJRA_SKIP_ARCHITECT_GATE=1 to override.\"\n1070\t            );\n1071\t        }\n1072\t    }\n1073\t\n1074\t    // Planner gate (S64): the pipeline's 2nd governed handoff. You cannot advance INTO session N+1\n1075\t    // unless its prompt's `## Plan` COVERS every acceptance criterion — the pre-execution mirror of\n1076\t    // the fidelity Validator. A placeholder/uncovered plan BLOCKS; a wholly absent plan only WARNS\n1077\t    // (legacy compat). Same fail-closed-at-L2/L3, advise-at-L1 posture; `VAJRA_SKIP_PLANNER_GATE=1`\n1078\t    // is the documented override (distinct from the Analyst gate's, so each stage overrides alone).\n1079\t    let plan_verdict = planner::plan_gate(&root, next);\n1080\t    for w in &plan_verdict.warnings {\n1081\t        eprintln!(\"  ⚠ {w}\");\n1082\t    }\n1083\t    if plan_verdict.blocked() {\n1084\t        eprintln!(\"[vajra planner] the plan for session {next:02} does NOT cover its contract:\");\n1085\t        for r in &plan_verdict.reasons {\n1086\t            eprintln!(\"    ✗ {r}\");\n1087\t        }\n1088\t        if maturity == MaturityLevel::L1 {\n1089\t            eprintln!(\"  (L1 advise — advancing anyway.)\");\n1090\t        } else if env::var(\"VAJRA_SKIP_PLANNER_GATE\").is_ok() {\n1091\t            eprintln!(\"  (VAJRA_SKIP_PLANNER_GATE set — advancing anyway.)\");\n1092\t        } else {\n1093\t            bail!(\n1094\t                \"refusing to advance: session {next:02}'s `## Plan` does not cover every acceptance \\\n1095\t                 criterion (Planner gate). Run `vajra next --plan {next:02}`, record a covering plan, \\\n1096\t                 or set VAJRA_SKIP_PLANNER_GATE=1 to override.\"\n1097\t            );\n1098\t        }\n1099\t    }\n1100\t\n1101\t    if maturity != MaturityLevel::L3 {\n1102\t        if !confirm(\"Advance to next session?\")? {\n1103\t            eprintln!(\"Aborted.\");\n1104\t            return Ok(());\n1105\t        }\n1106\t    } else {\n1107\t        eprintln!(\"L3 auto-advance — skipping confirmation.\");\n1108\t    }\n1109\t\n1110\t    fs::write(root.join(\".ai/SESSION\"), format!(\"{next:02}\\n\"))\n1111\t        .context(\"failed to write .ai/SESSION\")?;\n1112\t\n1113\t    update_session_boot(&root, current, next)?;\n1114\t\n1115\t    let next_prompt = find_next_prompt(&root, next);\n1116\t    if let Some(ref prompt_path) = next_prompt {\n1117\t        update_prompt_pointer(&root, \".ai/TASK.md\", prompt_path)?;\n1118\t        update_prompt_pointer(&root, \".ai/SESSION-BOOT.md\", prompt_path)?;\n1119\t    }\n1120\t\n1121\t    eprintln!();\n1122\t    eprintln!(\"Advanced: session {current:02} → {next:02}\");\n1123\t    eprintln!(\"  .ai/SESSION updated\");\n1124\t    eprintln!(\"  .ai/SESSION-BOOT.md updated\");\n1125\t    if let Some(ref prompt_path) = next_prompt {\n1126\t        eprintln!(\"  prompt pointer → {prompt_path}\");\n1127\t    } else {\n1128\t        eprintln!(\"  warning: no prompt found for session {next:02} in prompts/\");\n1129\t    }\n1130\t\n1131\t    Ok(())\n1132\t}\n1133\t\n1134\tfn update_session_boot(root: &Path, current: u32, next: u32) -> Result<()> {\n1135\t    let path = root.join(\".ai/SESSION-BOOT.md\");\n1136\t    let content = fs::read_to_string(&path).context(\"failed to read .ai/SESSION-BOOT.md\")?;\n1137\t\n1138\t    let current_str = format!(\"{current:02}\");\n1139\t    let next_str = format!(\"{next:02}\");\n1140\t\n1141\t    let updated: String = content\n1142\t        .lines()\n1143\t        .map(|line| {\n1144\t            if line.contains(\"**Number:**\") {\n1145\t                line.replace(&current_str, &next_str)\n1146\t            } else {\n1147\t                line.to_string()\n1148\t            }\n1149\t        })\n1150\t        .collect::<Vec<_>>()\n1151\t        .join(\"\\n\");\n1152\t\n1153\t    let updated = if content.ends_with('\\n') && !updated.ends_with('\\n') {\n1154\t        updated + \"\\n\"\n1155\t    } else {\n1156\t        updated\n1157\t    };\n1158\t\n1159\t    fs::write(&path, updated).context(\"failed to write .ai/SESSION-BOOT.md\")?;\n1160\t    Ok(())\n1161\t}\n1162\t\n1163\tfn confirm(question: &str) -> Result<bool> {\n1164\t    eprint!(\"{question} [y/N] \");\n1165\t    io::stderr().flush()?;\n1166\t    let mut line = String::new();\n1167\t    let bytes = io::stdin()\n1168\t        .lock()\n1169\t        .read_line(&mut line)\n1170\t        .context(\"failed to read input\")?;\n1171\t    if bytes == 0 {\n1172\t        return Ok(false);\n1173\t    }\n1174\t    Ok(matches!(\n1175\t        line.trim().to_ascii_lowercase().as_str(),\n1176\t        \"y\" | \"yes\"\n1177\t    ))\n1178\t}\n1179\t\n1180\tfn find_repo_root(start: &Path) -> Option<PathBuf> {\n1181\t    start\n1182\t        .ancestors()\n1183\t        .find(|dir| dir.join(\".ai\").is_dir())\n1184\t        .map(Path::to_path_buf)\n1185\t}\n1186\t\n1187\t/// The Vajra repo root from the current directory (the `.ai/`-carrying ancestor).\n1188\tfn repo_root() -> Result<PathBuf> {\n1189\t    let cwd = env::current_dir().context(\"failed to read current directory\")?;\n1190\t    find_repo_root(&cwd).context(\"could not find a Vajra repo (.ai directory missing)\")\n1191\t}\n1192\t\n1193\tfn current_branch(root: &Path) -> String {\n1194\t    Command::new(\"git\")\n1195\t        .arg(\"branch\")\n1196\t        .arg(\"--show-current\")\n1197\t        .current_dir(root)\n1198\t        .output()\n1199\t        .ok()\n1200\t        .filter(|output| output.status.success())\n1201\t        .and_then(|output| String::from_utf8(output.stdout).ok())\n1202\t        .map(|stdout| stdout.trim().to_string())\n1203\t        .filter(|branch| !branch.is_empty())\n1204\t        .unwrap_or_else(|| \"?\".to_string())\n1205\t}\n1206\t\n1207\tfn print_file(root: &Path, relative: &str) -> Result<()> {\n1208\t    let path = root.join(relative);\n1209\t    let content =\n1210\t        fs::read_to_string(&path).with_context(|| format!(\"failed to read {}\", path.display()))?;\n1211\t\n1212\t    println!(\"----- {relative} -----\");\n1213\t    print!(\"{content}\");\n1214\t    if !content.ends_with('\\n') {\n1215\t        println!();\n1216\t    }\n1217\t    println!();\n1218\t\n1219\t    Ok(())\n1220\t}\n1221\t\n1222\tfn find_next_prompt(root: &Path, next: u32) -> Option<String> {\n1223\t    let prompts_dir = root.join(\"prompts\");\n1224\t    let prefix = format!(\"{next:02}-task-\");\n1225\t\n1226\t    fs::read_dir(&prompts_dir)\n1227\t        .ok()?\n1228\t        .filter_map(|e| e.ok())\n1229\t        .find_map(|e| {\n1230\t            let name = e.file_name().to_string_lossy().to_string();\n1231\t            if name.starts_with(&prefix) && name.ends_with(\".md\") {\n1232\t                Some(format!(\"prompts/{name}\"))\n1233\t            } else {\n1234\t                None\n1235\t            }\n1236\t        })\n1237\t}\n1238\t\n1239\tfn update_prompt_pointer(root: &Path, relative: &str, new_prompt: &str) -> Result<()> {\n1240\t    let path = root.join(relative);\n1241\t    let content = match fs::read_to_string(&path) {\n1242\t        Ok(c) => c,\n1243\t        Err(_) => return Ok(()),\n1244\t    };\n1245\t\n1246\t    let updated: String = content\n1247\t        .lines()\n1248\t        .map(|line| {\n1249\t            if !line.to_ascii_lowercase().contains(\"read prompt\") {\n1250\t                return line.to_string();\n1251\t            }\n1252\t            let Some(start) = line.find('`') else {\n1253\t                return line.to_string();\n1254\t            };\n1255\t            let tail = &line[start + 1..];\n1256\t            let Some(end) = tail.find('`') else {\n1257\t                return line.to_string();\n1258\t            };\n1259\t            format!(\"{}`{new_prompt}`{}\", &line[..start], &tail[end + 1..])\n1260\t        })\n1261\t        .collect::<Vec<_>>()\n1262\t        .join(\"\\n\");\n1263\t\n1264\t    let updated = if content.ends_with('\\n') && !updated.ends_with('\\n') {\n1265\t        updated + \"\\n\"\n1266\t    } else {\n1267\t        updated\n1268\t    };\n1269\t\n1270\t    fs::write(&path, updated).with_context(|| format!(\"failed to write {relative}\"))?;\n1271\t    Ok(())\n1272\t}\n1273\t\n1274\tfn extract_prompt_path(content: &str) -> Option<String> {\n1275\t    content.lines().find_map(extract_backticked_prompt)\n1276\t}\n1277\t\n1278\tfn extract_backticked_prompt(line: &str) -> Option<String> {\n1279\t    if !line.to_ascii_lowercase().contains(\"read prompt\") {\n1280\t        return None;\n1281\t    }\n1282\t\n1283\t    let start = line.find('`')?;\n1284\t    let tail = &line[start + 1..];\n1285\t    let end = tail.find('`')?;\n1286\t    Some(tail[..end].to_string())\n1287\t}\n1288\t\n1289\t#[cfg(test)]\n1290\tmod tests {\n1291\t    use super::*;\n1292\t\n1293\t    /// S99 (AC3): the packet's classification encodes the SAME rule `hook-commit-guard.sh` applies\n1294\t    /// (session digits from a `session-NN-*` branch; off such a branch any non-empty marker is\n1295\t    /// accepted) — so the packet can never say \"pre-granted\" where the guard would block. This\n1296\t    /// test checks the Rust classification table; LIVE parity against the actual guard script (its\n1297\t    /// real allow/block exit code under each env) is proven in `scripts/verify-session-99.sh`.\n1298\t    #[test]\n1299\t    fn commit_authorization_mirrors_the_guard() {\n1300\t        // Marker matches the branch-derived session -> the guard ALLOWs.\n1301\t        assert_eq!(\n1302\t            commit_authorization(\"session-99-coder-reachable\", Some(\"99\")),\n1303\t            CommitAuth::PreGranted(\"99\".into())\n1304\t        );\n1305\t        // Marker scoped to another session -> the guard BLOCKs; never report pre-granted.\n1306\t        assert_eq!(\n1307\t            commit_authorization(\"session-99-coder-reachable\", Some(\"98\")),\n1308\t            CommitAuth::Mismatch {\n1309\t                marker: \"98\".into(),\n1310\t                session: \"99\".into()\n1311\t            }\n1312\t        );\n1313\t        // No marker (or an empty one) -> a chat token is the only route.\n1314\t        assert_eq!(\n1315\t            commit_authorization(\"session-99-x\", None),\n1316\t            CommitAuth::TokenRequired\n1317\t        );\n1318\t        assert_eq!(\n1319\t            commit_authorization(\"session-99-x\", Some(\"\")),\n1320\t            CommitAuth::TokenRequired\n1321\t        );\n1322\t        // Off a session branch the guard accepts any non-empty marker — mirror it, don't invent.\n1323\t        assert_eq!(\n1324\t            commit_authorization(\"main\", Some(\"99\")),\n1325\t            CommitAuth::PreGranted(\"99\".into())\n1326\t        );\n1327\t        assert_eq!(\n1328\t            commit_authorization(\"main\", None),\n1329\t            CommitAuth::TokenRequired\n1330\t        );\n1331\t        // A malformed branch is not a session branch.\n1332\t        assert_eq!(\n1333\t            commit_authorization(\"session-abc-x\", Some(\"7\")),\n1334\t            CommitAuth::PreGranted(\"7\".into())\n1335\t        );\n1336\t    }\n1337\t\n1338\t    /// The rendered lines must name the un-forgeable route for an UNATTENDED run, and must\n1339\t    /// disclose that this surface is advisory rather than a permission.\n1340\t    #[test]\n1341\t    fn commit_auth_lines_state_route_and_bound() {\n1342\t        let granted = render_commit_auth(CommitAuth::PreGranted(\"99\".into()));\n1343\t        assert!(granted.contains(\"PRE-GRANTED\"));\n1344\t        assert!(granted.contains(\"approval token\"));\n1345\t        assert!(\n1346\t            granted.contains(\"Advisory\"),\n1347\t            \"pre-granted line hides that it is not the enforcing check\"\n1348\t        );\n1349\t\n1350\t        let required = render_commit_auth(CommitAuth::TokenRequired);\n1351\t        assert!(required.contains(\"REQUIRED\"));\n1352\t        assert!(\n1353\t            required.contains(\"VAJRA_ALLOW_COMMIT=NN vajra claude\"),\n1354\t            \"packet does not tell an unattended run how to be pre-authorized\"\n1355\t        );\n1356\t\n1357\t        let bad = render_commit_auth(CommitAuth::Mismatch {\n1358\t            marker: \"98\".into(),\n1359\t            session: \"99\".into(),\n1360\t        });\n1361\t        assert!(bad.contains(\"NOT VALID HERE\") && bad.contains(\"BLOCK\"));\n1362\t    }\n1363\t\n1364\t    #[test]\n1365\t    fn extract_prompt_path_reads_task_pointer() {\n1366\t        let task = \"Read prompt: `prompts/04-task-launcher.md`\";\n1367\t        assert_eq!(\n1368\t            extract_prompt_path(task),\n1369\t            Some(\"prompts/04-task-launcher.md\".to_string())\n1370\t        );\n1371\t    }\n1372\t\n1373\t    #[test]\n1374\t    fn extract_prompt_path_reads_session_boot_pointer() {\n1375\t        let boot = \"- **Read prompt:** `prompts/05-task-next.md`\";\n1376\t        assert_eq!(\n1377\t            extract_prompt_path(boot),\n1378\t            Some(\"prompts/05-task-next.md\".to_string())\n1379\t        );\n1380\t    }\n1381\t\n1382\t    #[test]\n1383\t    fn extract_prompt_path_ignores_other_lines() {\n1384\t        assert_eq!(extract_prompt_path(\"no prompt here\"), None);\n1385\t    }\n1386\t\n1387\t    #[test]\n1388\t    fn find_next_prompt_finds_matching_file() {\n1389\t        let tmp = tempfile::tempdir().unwrap();\n1390\t        let prompts = tmp.path().join(\"prompts\");\n1391\t        fs::create_dir_all(&prompts).unwrap();\n1392\t        fs::write(prompts.join(\"02-task-add-goodbye.md\"), \"# S02\").unwrap();\n1393\t        fs::write(prompts.join(\"01-task-kickoff.md\"), \"# S01\").unwrap();\n1394\t\n1395\t        assert_eq!(\n1396\t            find_next_prompt(tmp.path(), 2),\n1397\t            Some(\"prompts/02-task-add-goodbye.md\".to_string())\n1398\t        );\n1399\t        assert_eq!(find_next_prompt(tmp.path(), 3), None);\n1400\t    }\n1401\t\n1402\t    #[test]\n1403\t    fn update_prompt_pointer_replaces_backticked_path() {\n1404\t        let tmp = tempfile::tempdir().unwrap();\n1405\t        let ai = tmp.path().join(\".ai\");\n1406\t        fs::create_dir_all(&ai).unwrap();\n1407\t        fs::write(\n1408\t            ai.join(\"TASK.md\"),\n1409\t            \"# Task\\nRead prompt: `prompts/01-task-kickoff.md`\\n\",\n1410\t        )\n1411\t        .unwrap();\n1412\t\n1413\t        update_prompt_pointer(tmp.path(), \".ai/TASK.md\", \"prompts/02-task-add-goodbye.md\").unwrap();\n1414\t\n1415\t        let result = fs::read_to_string(ai.join(\"TASK.md\")).unwrap();\n1416\t        assert!(result.contains(\"`prompts/02-task-add-goodbye.md`\"));\n1417\t        assert!(!result.contains(\"01-task-kickoff\"));\n1418\t    }\n1419\t\n1420\t    #[test]\n1421\t    fn scaffold_and_point_writes_prompt_and_repoints_task() {\n1422\t        let tmp = tempfile::tempdir().unwrap();\n1423\t        let ai = tmp.path().join(\".ai\");\n1424\t        fs::create_dir_all(&ai).unwrap();\n1425\t        fs::write(\n1426\t            ai.join(\"TASK.md\"),\n1427\t            \"# Task\\nRead prompt: `prompts/60-task-old.md`\\n\",\n1428\t        )